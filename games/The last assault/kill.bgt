#include"includes/bullet.bgt"
#include"includes/enemy.bgt"
#include"includes/sound_pool.bgt"
#include"includes/bodyfall.bgt"
#include"includes/map.bgt"
#include"includes/staircase.bgt"
#include"includes/src.bgt"
#include"includes/readable_time.bgt"
#include"includes/dlg.bgt"
#include"includes/dlgplayer.bgt"
#include"includes/menu.bgt"
#include"includes/virtualizer.bgt"
#include"includes/inventory.bgt"
#include"includes/m_pro.bgt"
int x, y, z;
int maxx, maxy;
int weapon, damage, range, time, speed, ammo, maxammo, reloadtime;
bool scatter, melee;
int facing;
int level=1;
bool atapex;
int jumptime=130;
int apextime=150;
int jumptime2=150;
bool ascending;
int jumpheight=5;
int jumping;
int ty1, ty2;
int jumpable=1;
int health;
int movetime;
int walktime=200;
int airtime=90;
int medtime=350;
int medpoints=0;
string currentloc;
string gametime;
double xp=0;
double xprequired=100;
string i, itemnum;
string mapname;
string weaponname;
vector me, store;
sound_pool p;
virtualizer v;
sound bleading;
timer gametimer, movetimer, jumptimer, weapontimer, medtimer, reloadtimer, storemovetimer;
bool reloading=false;
void main()
{
if (screen_reader_is_running(1)) install_keyhook();
set_sound_storage("sounds.dat");
set_sound_decryption_key("fwjrgiorw2iorweofwoiwefonfeoifew",true);
show_game_window("Game with no title");
p.behind_pitch_decrease=7;
sp.behind_pitch_decrease=7;
bleading.load("lowhealth.ogg");
mainmenu();
}
void game()
{
inv.delete_all();
health=random(250,1000);
give("handgun ammo",20);
give("handgun clip",2);
p.play_2d("store.ogg",me.x,me.y,store.x,store.y,true);
while(true)
{
bulletloop();
staircasecheckloop();
enemyloop();
sourceloop();
bodyfallloop();
checkloc();
p.update_listener_3d(me.x,me.y,me.z);
gametime=ms_to_readable_time(gametimer.elapsed);
wait(5);
if (health<=20 and health>0)
{
bleading.play_looped();
}
if (key_pressed(KEY_B))
{
if (get_zone_at(me.x,me.y, me.z)!="")
{
string locate=get_zone_at(me.x,me.y, me.z);
speak("Current location: "+locate+" of "+mapname);
}
else
{
speak("No location");
}
}
if (storemovetimer.elapsed>=600000)
{
storemovetimer.restart();
store.x=random(0,maxx);
store.y=random(0,maxx);
}
if (key_pressed(KEY_T))
{
speak("You have survived for "+gametime+".");
}
if (medtimer.elapsed>=medtime and medpoints<300 and usingmedkit==true)
{
medpoints++;
health++;
}
if (medpoints>=300) usingmedkit=false;
if (key_pressed(KEY_1))
{
weapon=1;
draw_weapon("fists",8,4,140,10,0,true,0,false);
}
if (key_pressed(KEY_2))
{
weapon=2;
draw_weapon("handgun",12,15,250,50,20,false,1590,false);
}
if (key_pressed(KEY_3) and level>=2)
{
weapon=3;
draw_weapon("machinegun",25,40,80,20,30,false,4338,false);
}
if (key_pressed(KEY_DELETE) and !SCRIPT_COMPILED)
{
invchange();
}
if (key_pressed(KEY_A) and reloading==false)
{
if (!melee)
{
speak(get_weapon_ammo()+" ammo loaded, "+get_weapon_clips()+" clips left.");
}
else
{
speak("This weapon doesn't take ammo.");
}
}
if (xp>=xprequired)
{
p.play_stationary("level.ogg",false);
level+=1;
xprequired=(50*(level*(level*2)));
}
if (key_pressed(KEY_L))
{
speak("You are level "+level+" with "+xp+" experience. You need "+(xprequired-xp)+" experience to get to level "+(level+1)+".");
}
if (key_pressed(KEY_E))
{
speak(enemies.length()+" enemies are on the map.");
}
if (pressed_weapon_keys() and weapontimer.elapsed>=time and reloading==false)
{
weapontimer.restart();
if (melee==true)
{
play(weaponname);
spawn_bullet(damage,range,me.x,me.y,facing,speed);
}
else
{
if (get_weapon_ammo()>0)
{
play(weaponname);
spawn_bullet(damage,range,me.x,me.y,facing,speed);
give(weaponname+" ammo",-1);
}
else
{
play(weaponname+"empty");
}
}
}
if (held_weapon_keys() and weapontimer.elapsed>=time and reloading==false)
{
if (weapon==3)
{
weapontimer.restart();
if (get_weapon_ammo()>0)
{
play(weaponname);
spawn_bullet(damage,range,me.x,me.y,facing,speed);
give(weaponname+" ammo",-1);
}
else
{
play(weaponname+"empty");
}
}
}
if (key_pressed(KEY_R) and reloading==false)
{
if (!melee)
{
reload();
}
else
{
speak("This weapon doesn't take ammo.");
}
}
if (reloadtimer.elapsed>=reloadtime and reloading==true)
{
reloading=false;
}
if (key_pressed(KEY_Z) and !SCRIPT_COMPILED)
{
xp+=stn(v.input("How much xp do you want?"));
}
if (key_pressed(KEY_H))
{
speak(health+" hp");
}
if (health<=0)
{
play("kill"+random(1,3));
dlgplay("death.ogg",true,20);
reset();
mainmenu();
}
if (key_pressed(KEY_TAB))
{
if (shiftisdown()) cycle_inv(0);
else cycle_inv(1);
}
if (key_pressed(KEY_RETURN))
{
if (shiftisdown())
invstuff();
else
{
}
}
if (key_pressed(KEY_C))
{
speak(me.x+", "+me.y+", "+me.z);
}
if (jumping==1)
movetime=airtime;
else
movetime=walktime;
if (key_down(KEY_LEFT) and movetimer.elapsed>=movetime and me.x>0)
{
movetimer.restart();
facing=Left;
me.x--;
playstep();
}
if (key_down(KEY_RIGHT) and movetimer.elapsed>=movetime and me.x<maxx)
{
movetimer.restart();
facing=Right;
me.x++;
playstep();
}
if (key_down(KEY_DOWN) and movetimer.elapsed>=movetime and me.y>0)
{
movetimer.restart();
facing=Backward;
me.y--;
playstep();
}
if (key_down(KEY_UP) and movetimer.elapsed>=movetime and me.y<maxy)
{
movetimer.restart();
facing=Forward;
me.y++;
playstep();
}
if (me.z<0) me.z=0;
if (key_pressed(KEY_SPACE) and jumping==0 and jumpable==1)
{
sjumpcheck();
if (abletojump2>0)
{
p.play_stationary("jump.ogg",false);
ty1=me.z;
ty2=me.z+jumpheight;
jumping=1;
ascending=true;
}
}
if (jumping==1)
{
if (atapex==true and jumptimer.elapsed>=apextime)
{
jumptimer.restart();
atapex=false;
}
if (ascending==false and jumptimer.elapsed>=jumptime2 and atapex==false)
{
jumptimer.restart();
me.z-=1;
checkforplatforms();
/*
if (me.z<=ty1)
{
me.z=ty1;
p.play_stationary(tile+"land.ogg",false);
jumping=0;
}
*/
}
if (ascending==true and jumptimer.elapsed>=jumptime)
{
jumptimer.restart();
me.z+=1;
checkforplatforms();
if (me.z>=ty2)
{
ascending=false;
jumptimer.restart();
atapex=true;
}
}
}
if (key_pressed(KEY_ESCAPE))
{
int exitgame=menuquestion("Do you want to exit?");
if (exitgame==1)
{
reset();
mainmenu();
}
}
}
}
void checkforplatforms()
{
if (gmt()!="")
{
p.play_stationary(""+gmt()+"land.ogg",false);
jumping=0;
//falling=false;
}
}
void play(string snd, bool loop=false)
{
p.play_stationary(snd+".ogg",loop);
}
void checkloc()
{
if (get_zone_at(me.x,me.y, me.z)!="")
{
string locate=get_zone_at(me.x,me.y, me.z);
if (locate!=currentloc)
{
speak(locate);
currentloc=locate;
}
}
else
{
if (currentloc!="")
{
speak("Uncharted area");
currentloc="";
}
}
}
string get_location()
{
if (get_zone_at(me.x,me.y, me.z)!="")
{
string locate=get_zone_at(me.x,me.y, me.z);
return locate+" of "+string_replace(mapname,"","",true);
}
else
{
return "uncharted area on "+string_replace(mapname,"","",true);
}
}
void draw_weapon(string name, int wdamage, int wrange, int wtime, int wspeed, int wmaxammo, bool wmelee, int wreloadtime, bool weaponscatter)
{
play(name+"draw");
weaponname=name;
speak(name);
damage=wdamage;
range=wrange;
maxammo=wmaxammo;
melee=wmelee;
reloadtime=wreloadtime;
time=wtime;
speed=wspeed;
scatter=weaponscatter;
}
bool shiftisdown()
{
if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
return true;
}
return false;
}
bool altisdown()
{
if (key_down(KEY_LMENU) or key_down(KEY_RMENU))
{
return true;
}
return false;
}
int get_weapon_ammo()
{
return get_item_count(weaponname+" ammo");
}
int get_weapon_clips()
{
return get_item_count(weaponname+" clip");
}
bool pressed_weapon_keys()
{
if ((key_pressed(KEY_LCONTROL) or key_pressed(KEY_RCONTROL)))
{
return true;
}
return false;
}
bool held_weapon_keys()
{
if ((key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL)))
{
return true;
}
return false;
}
int bool_to_int(bool b)
{
if (b==true) return 1;
else return 0;
}
void reload()
{
if (get_weapon_ammo()>0)
{
speak("Your weapon still has ammo in it! Don't waste ammo!");
}
else
{
if (get_weapon_clips()>0)
{
reloadtimer.restart();
reloading=true;
play(weaponname+"reload");
give(weaponname+" clip",-1);
give(weaponname+" ammo",maxammo);
}
else
{
speak("No clips");
}
}
}
void reset()
{
bleading.stop();
p.destroy_all();
bullets.resize(0);
killenemies();
killbodyfalls();
sp.destroy_all();
killsrcs();
xp=0;
xprequired=100;
}
void invchange()
{
i=v.input("enter what item you want to give yourself.");
if (i=="")
{
return;
}
else
{
asknum();
}
}
void asknum()
{
itemnum=v.input("Enter how many to give yourself");
if (itemnum=="")
{
return;
}
else
{
int givenum=string_to_number(itemnum);
give(i,givenum);
speak("Success");
}
}
int stn(string thestring)
{
return string_to_number(thestring);
}