// Axis-aligned map-area index implemented with NVGT 0.89.1 native arrays.
// Areas are evaluated newest-first so later map lines retain priority where
// platform, wall, zone, safe-zone, and interaction bounds overlap.

enum map_flags
{
	MAP_TILE = 1 << 0,
	MAP_WALL = 1 << 1,
	MAP_STAIR = 1 << 2,
	MAP_ZONE = 1 << 3,
	MAP_SAFEZONE = 1 << 4,
	MAP_TRAVELPOINT = 1 << 5,
	MAP_DOOR = 1 << 6
}

class map_query_result
{
	string data1;
	string data2;
	string data3;
	int64 flags;
	map_query_result(const string&in d1 = "", const string&in d2 = "", const string&in d3 = "", int64 fl = 0)
	{
		data1 = d1;
		data2 = d2;
		data3 = d3;
		flags = fl;
	}
}

class map_area
{
	double minx, maxx, miny, maxy, minz, maxz;
	string data1, data2, data3;
	int64 flags;
	int priority;

	map_area(double x1, double x2, double y1, double y2, double z1, double z2,
		const string&in d1, const string&in d2, const string&in d3, int64 fl, int p)
	{
		minx = (x1 < x2) ? x1 : x2;
		maxx = (x1 > x2) ? x1 : x2;
		miny = (y1 < y2) ? y1 : y2;
		maxy = (y1 > y2) ? y1 : y2;
		minz = (z1 < z2) ? z1 : z2;
		maxz = (z1 > z2) ? z1 : z2;
		data1 = d1;
		data2 = d2;
		data3 = d3;
		flags = fl;
		priority = p;
	}

	bool contains(double x, double y, double z) const
	{
		return x >= minx && x <= maxx && y >= miny && y <= maxy && z >= minz && z <= maxz;
	}
}

class native_map
{
	map_area@[] areas;
	int priority_counter = 0;
	string name = "";
	double minx = 0, maxx = 0, miny = 0, maxy = 0, minz = 0, maxz = 0;

	void reset_data()
	{
		areas.resize(0);
		priority_counter = 0;
	}

	void add_area(double x1, double x2, double y1, double y2, double z1, double z2,
		const string&in d1, const string&in d2 = "", const string&in d3 = "", int64 flags = 0)
	{
		map_area area(x1, x2, y1, y2, z1, z2, d1, d2, d3, flags, priority_counter++);
		areas.insert_last(area);
	}

	void add_tile(double x1, double x2, double y1, double y2, double z1, double z2, const string&in type)
	{
		add_area(x1, x2, y1, y2, z1, z2, type, "", "", MAP_TILE);
	}

	void add_wall(double x1, double x2, double y1, double y2, double z1, double z2, const string&in type)
	{
		add_area(x1, x2, y1, y2, z1, z2, type, "", "", MAP_WALL);
	}

	void add_stair(double x1, double x2, double y1, double y2, double z1, double z2, const string&in type)
	{
		add_area(x1, x2, y1, y2, z1, z2, type, "", "", MAP_STAIR);
	}

	void add_zone(double x1, double x2, double y1, double y2, double z1, double z2, const string&in label)
	{
		add_area(x1, x2, y1, y2, z1, z2, label, "", "", MAP_ZONE);
	}

	void add_safezone(double x1, double x2, double y1, double y2, double z1, double z2, const string&in safe_type)
	{
		add_area(x1, x2, y1, y2, z1, z2, safe_type, "", "", MAP_SAFEZONE);
	}

	void add_travelpoint(double x1, double x2, double y1, double y2, double z1, double z2,
		double dx1, double dx2, double dy1, double dy2, double dz1, double dz2,
		const string&in target_map, int autotp = 1)
	{
		string coords = dx1 + ":" + dx2 + ":" + dy1 + ":" + dy2 + ":" + dz1 + ":" + dz2;
		add_area(x1, x2, y1, y2, z1, z2, target_map, coords, "" + autotp, MAP_TRAVELPOINT);
	}

	void add_door(double x1, double x2, double y1, double y2, double z1, double z2,
		const string&in open_sound, const string&in close_sound, const string&in surface,
		const string&in password = "")
	{
		add_area(x1, x2, y1, y2, z1, z2, open_sound + ":" + close_sound + ":" + surface, password, "", MAP_DOOR);
	}

	map_area@ get(double x, double y, double z, int64 flag) const
	{
		for (int i = int(areas.length()) - 1; i >= 0; i--)
		{
			map_area@ area = areas[i];
			if (area !is null && (area.flags & flag) != 0 && area.contains(x, y, z)) return area;
		}
		return null;
	}

	string get_tile(double x, double y, double z) const
	{
		map_area@ area = get(x, y, z, MAP_TILE);
		return (area is null) ? "" : area.data1;
	}


	string get_wall(double x, double y, double z) const
	{
		map_area@ area = get(x, y, z, MAP_WALL);
		return (area is null) ? "" : area.data1;
	}

	string get_stair(double x, double y, double z) const
	{
		map_area@ area = get(x, y, z, MAP_STAIR);
		return (area is null) ? "" : area.data1;
	}

	string get_zone(double x, double y, double z) const
	{
		map_area@ area = get(x, y, z, MAP_ZONE);
		return (area is null) ? "" : area.data1;
	}

	string get_safezone(double x, double y, double z) const
	{
		map_area@ area = get(x, y, z, MAP_SAFEZONE);
		return (area is null) ? "" : area.data1;
	}

	bool is_safezone(double x, double y, double z) const
	{
		return get(x, y, z, MAP_SAFEZONE) !is null;
	}

	bool wall_blocks(double x, double y, double z) const
	{
		return get(x, y, z, MAP_WALL) !is null;
	}
}

native_map g_active_map;
