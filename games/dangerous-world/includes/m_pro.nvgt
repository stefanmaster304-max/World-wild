// Menu navigation helper: true when a menu action is pressed, with hold-to-
// repeat so the keyboard arrows and keyboard navigation scroll menus
// comfortably. The navigation actions (menu_up, menu_down, menu_left,
// menu_right, menu_activate, menu_back, menu_home, menu_end) are rebindable
// from the keybindings menu and keep menu navigation consistent. Repeat profile:
// immediate edge, then 250ms, then 100ms while held (close to the old
// key_hold feel but with instant first response).
dictionary menu_nav_latch;
dictionary menu_nav_phase;
timer menu_nav_timer;
bool menu_nav_pressed(string action)
{
    if (kb_down(action))
    {
        bool was = false;
        if (menu_nav_latch.exists(action)) menu_nav_latch.get(action, was);
        if (!was)
        {
            menu_nav_latch.set(action, true);
            menu_nav_phase.set(action, 0);
            menu_nav_timer.restart();
            return true;
        }
        int phase = 0;
        if (menu_nav_phase.exists(action)) menu_nav_phase.get(action, phase);
        int interval = phase == 0 ? 250 : 100;
        if (menu_nav_timer.elapsed >= interval)
        {
            menu_nav_phase.set(action, phase + 1);
            menu_nav_timer.restart();
            return true;
        }
        return false;
    }
    menu_nav_latch.set(action, false);
    return false;
}
int found_reader=0;
sound_pool spool;
void fade(sound@ handle, double final_volume=-100.0, double delay=25)
{
	if (@handle == null) return;
	if (handle.volume <= final_volume) return;
	while (handle.volume > final_volume and handle.active)
	{
		handle.volume = handle.volume - 2.0;
		handle.set_position(0, 0, 0, 0, 0, 0, 0, 0, 0);
		if (handle.volume <= final_volume) break;
		wait(delay);
	}
}

class dynamic_menu_item
{
string option;
bool is_filename;
bool activate;
string name;
string letter;
dynamic_menu_item()
{
option="";
is_filename=true;
name="";
activate=false;
}
}

class dynamic_menu_pro
{
bool letters_autospeak=true;
bool letters_autoactivate;
bool speak_letter;
bool enable_first_letter_navigation;
bool click_at_edge;
bool repeat_items_at_edges;
bool music_added=false;
int voltime=50;
timer voltimer;
sound music;
int volkeyup=KEY_PRIOR;
int volkeydown=KEY_NEXT;
int volkeycheck=KEY_V;
string open_sound;
string click_sound;
string edge_sound;
string wrap_sound;
string enter_sound;
bool enable_numbers;
bool enable_space;
bool enable_enter;
bool speak_position_information;
bool enable_side_scrolling;
bool wrap;
bool allow_escape;
bool force_sapi;
bool enable_home_and_end;
bool enable_up_and_down;
bool enable_left_and_right;
int last_position=0;
bool restore_last_position=false;

void set_volume_keys(int key1, int key2, int key3)
{
volkeyup=key1;
volkeydown=key2;
volkeycheck=key3;
}
void fade_music(int value1) { if (music.active and music.playing) { fade(music,-50,value1); } music.stop(); }
void stop_music() { music.stop(); }
void play_music() { if(!music.playing) music.play_looped(); }
void add_music(string musicpath)
{
if(musicpath=="")
{
music.stop();
music.close();
music_added=false;
return;
}
if(!music.playing)
{
music.load(musicpath);
music.set_hrtf(true);
music_added=true;
}
}

void play_click_sound()
{
if(click_sound=="" and file_exists(click_sound)) return;
if(enable_side_scrolling)
spool.play_stationary_extended(click_sound, false, 0, (menu_position*100/get_item_count())-50, 0, 100, false);
else
spool.play_stationary(click_sound, false, false);
}
void play_edge_sound()
{
if(edge_sound=="" and file_exists(edge_sound)) return;
if(enable_side_scrolling)
spool.play_stationary_extended(edge_sound, false, 0, (menu_position*100/get_item_count())-50, 0, 100, false);
else
spool.play_stationary(edge_sound, false, false);
}
void play_enter_sound()
{
if(enter_sound=="" and file_exists(enter_sound)) return;
if(enable_side_scrolling)
spool.play_stationary_extended(enter_sound, false, 0, (menu_position*100/get_item_count())-50, 0, 100, false);
else
spool.play_stationary(enter_sound, false, false);
}

dynamic_menu_pro()
{
running=false;
reset(true);
}

int add_item(string filename, string name="", string key="", bool act=true)
{
return add_item_extended(filename, true, name, key, act);
}
int add_item_tts(string text, string name="", string key="", bool act=true)
{
return add_item_extended(text, false, name, key, act);
}

bool set_speech_mode(int speech_output)
{
if(speech_output<0 or speech_output>4) return false;
this.speech_output=speech_output;
return true;
}
int get_item_count() { return item_list.length(); }
int get_position() { return running ? menu_position : -1; }
bool is_running() { return running; }

bool set_tts_object(tts_voice@ handle)
{
if(running) return false;
@tts_handle=@handle;
return true;
}
bool set_sound_object(sound@ handle)
{
if(running) return false;
@sound_handle=@handle;
return true;
}
bool set_callback(menu_callback@ callback, string user_data)
{
if(running) return false;
@callback_handle=@callback;
callback_data=user_data;
return true;
}

string get_item_name(int item)
{
if(item<1 or item>item_list.length()) return "";
return item_list[item-1].name;
}

int run(string intro, bool is_intro_tts, int should_interrupt=1)
{
int start=0;
bool auto_speak=false;
if(restore_last_position and last_position>=1)
{
start=last_position;
auto_speak=true;
}
return run_extended(intro, is_intro_tts, start, auto_speak, should_interrupt);
}

int run_extended(string intro, bool is_intro_tts, int start_position, bool auto_speak_first, int should_interrupt)
{
if(running) return -1;
int item_count=item_list.length();
if(item_count==0) return -1;
if(start_position>item_count) return -1;
if(start_position<1 and auto_speak_first) return -1;
menu_position=start_position;
bool speak_item=false;
bool initial=auto_speak_first;
sound@ internal_sound;
tts_voice@ internal_tts;
if(@sound_handle==null)
{
sound temp_sound;
@internal_sound=temp_sound;
}
else
{
@internal_sound=sound_handle;
}
bool has_tts_items=is_intro_tts;
if(!has_tts_items)
{
for(int i=0;i<item_count;i++)
{
if(!item_list[i].is_filename)
{
has_tts_items=true;
break;
}
}
}
if(speech_output==0 and has_tts_items)
{
if(@tts_handle==null)
{
tts_voice temp_voice;
@internal_tts=temp_voice;
}
else
{
@internal_tts=tts_handle;
}
}
if(intro!="")
{
if(is_intro_tts)
{
if(speech_output>0 and speech_output<5)
{
if(!screen_reader_speak_interrupt(speech_output, intro)) return -1;
}
else if(!force_sapi)
{
if(!speak(intro)) return -1;
}
else
{
if(!internal_tts.speak_interrupt(intro)) return -1;
}
}
else
{
if(!internal_sound.stream(intro)) return -1;
internal_sound.play();
}
}
spool.play_stationary(open_sound, false);
if (music_added)
{
	if (menu_music_volume > 0.0) menu_music_volume = 0.0;
	if (menu_music_volume < -100.0) menu_music_volume = -100.0;
	music.volume = menu_music_volume;
	music.set_hrtf(true);
	if (!music.playing) music.play_looped();
}
running=true;
if(enable_first_letter_navigation) get_characters();
int[] num_keys={KEY_1,KEY_2,KEY_3,KEY_4,KEY_5,KEY_6,KEY_7,KEY_8,KEY_9,KEY_0,KEY_MINUS,KEY_EQUALS,KEY_BACK};
while(true)
{
update_game_world();
if(enable_first_letter_navigation)
{
string char=get_characters();
if(char.length()>0)
{
char=string_to_lower_case(char.substr(0,1));
}
if(char!="" and !string_is_digits(char))
{
int current=menu_position-1;
int found=-1;
for(uint i=current+1; i<item_list.length(); i++)
{
if(item_list[i].letter==char) { found=i; break; }
}
if(found==-1)
{
for(int i=0; i<=current; i++)
{
if(item_list[i].letter==char) { found=i; break; }
}
}
if(found!=-1)
{
menu_position=found+1;
play_click_sound();
if(letters_autospeak) speak_item=true;
if(letters_autoactivate)
{
play_enter_sound();
last_position=menu_position;
running=false;
return menu_position;
}
}
}
}

if(@callback_handle!=null)
{
int callback_result=callback_handle(this, callback_data);
if(callback_result!=0)
{
running=false;
return callback_result;
}
}

if(speak_item)
{
int pos=menu_position-1;
string secondary=speak_letter ? " "+item_list[pos].letter : "";
if(item_list[pos].is_filename)
{
if(@internal_tts!=null) internal_tts.stop();
if(!internal_sound.stream(item_list[pos].option)) { running=false; return -1; }
internal_sound.play();
}
else
{
if(internal_sound.active) internal_sound.close();
string label=item_list[pos].option+secondary;
if(speak_position_information) label+=". "+menu_position+" of "+item_count;
if(speech_output>0 and speech_output<5)
{
if(!screen_reader_speak_interrupt(speech_output, label)) { running=false; return -1; }
}
else if(!force_sapi)
{
if(!speak(label)) { running=false; return -1; }
}
else
{
if(!internal_tts.speak_interrupt(label)) { running=false; return -1; }
}
}
speak_item=false;
continue;
}

if(initial)
{
bool finished_intro=false;
if(!is_intro_tts)
{
finished_intro=!internal_sound.playing;
}
else if(speech_output>0 and speech_output<5)
{
finished_intro=true;
}
else
{
finished_intro=!internal_tts.speaking;
}
if(finished_intro)
{
initial=false;
if(item_list[menu_position-1].is_filename)
{
speak_item=true;
continue;
}
else
{
if(speech_output>0 and speech_output<5)
{
if(!screen_reader_speak(speech_output, item_list[menu_position-1].option)) { running=false; return -1; }
}
else
{
speak_item=true;
continue;
}
}
}
}

if(enable_numbers)
{
for(int k=0; k<13; k++)
{
if(!key_pressed(num_keys[k])) continue;
bool shifted=key_down(KEY_RSHIFT);
if(!shifted and item_count>=k+1)
{
menu_position=k+1;
play_click_sound();
speak_item=true;
break;
}
else if(shifted and item_count>=k+14)
{
menu_position=k+14;
play_click_sound();
speak_item=true;
break;
}
}
}

if((enable_enter and (key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPAD_ENTER))) or (enable_space and key_pressed(KEY_SPACE)) or kb_pressed("menu_activate"))
{
if(menu_position!=0 and item_list[menu_position-1].activate)
{
play_enter_sound();
last_position=menu_position;
running=false;
return menu_position;
}
}

if(allow_escape and (key_pressed(KEY_ESCAPE) or kb_pressed("menu_back")))
{
running=false;
return 0;
}

if(key_pressed(volkeycheck))
{
string vol_msg="music volume: "+int(menu_music_volume)+" dB";
if(speech_output>0 and speech_output<5) screen_reader_speak_interrupt(speech_output, vol_msg);
else if(!force_sapi) speak(vol_msg);
else internal_tts.speak_interrupt(vol_msg);
}
if(key_down(volkeydown) and voltimer.elapsed>=voltime)
{
menu_music_volume=menu_music_volume-2;
if (menu_music_volume < -100.0) menu_music_volume = -100.0;
if (music.active) { music.volume = menu_music_volume; music.set_position(0, 0, 0, 0, 0, 0, 0, 0, 0); }
writeprefs();
voltimer.restart();
}
if(key_down(volkeyup) and voltimer.elapsed>=voltime)
{
menu_music_volume=menu_music_volume+2;
if (menu_music_volume > 0.0) menu_music_volume = 0.0;
if (music.active) { music.volume = menu_music_volume; music.set_position(0, 0, 0, 0, 0, 0, 0, 0, 0); }
writeprefs();
voltimer.restart();
}

if((enable_up_and_down and menu_nav_pressed("menu_up")) or (enable_left_and_right and menu_nav_pressed("menu_left")))
{
initial=false;
if(menu_position==0)
{
menu_position=item_count;
}
else if(menu_position==1)
{
if(wrap)
{
menu_position=item_count;
spool.play_stationary(wrap_sound, false);
}
else
{
if(click_at_edge) play_click_sound();
if(repeat_items_at_edges) speak_item=true;
play_edge_sound();
continue;
}
}
else
{
menu_position-=1;
}
play_click_sound();
speak_item=true;
continue;
}

if((enable_up_and_down and menu_nav_pressed("menu_down")) or (enable_left_and_right and menu_nav_pressed("menu_right")))
{
initial=false;
if(menu_position==item_count)
{
if(wrap)
{
menu_position=1;
spool.play_stationary(wrap_sound, false);
}
else
{
if(click_at_edge) play_click_sound();
if(repeat_items_at_edges) speak_item=true;
play_edge_sound();
continue;
}
}
else
{
menu_position+=1;
}
play_click_sound();
speak_item=true;
continue;
}

if(enable_home_and_end)
{
if(key_pressed(KEY_HOME) or kb_pressed("menu_home"))
{
initial=false;
menu_position=1;
play_click_sound();
speak_item=true;
continue;
}
if(key_pressed(KEY_END) or kb_pressed("menu_end"))
{
initial=false;
menu_position=item_count;
play_click_sound();
speak_item=true;
continue;
}
}

wait(5);
}
running=false;
return -1;
}

bool reset(bool completely)
{
if(running) return false;
item_list.resize(0);
if(completely)
{
letters_autospeak=true;
letters_autoactivate=false;
speak_letter=false;
enable_first_letter_navigation=false;
click_at_edge=false;
repeat_items_at_edges=false;
music_added=false;
volkeyup=KEY_PRIOR;
volkeydown=KEY_NEXT;
enable_space=false;
enable_enter=true;
speak_position_information=false;
open_sound="";
edge_sound="";
music.close();
click_sound="";
force_sapi=false;
enable_up_and_down=false;
enable_left_and_right=false;
wrap=true;
allow_escape=true;
enable_home_and_end=false;
speech_output=0;
last_position=0;
restore_last_position=false;
@tts_handle=null;
@sound_handle=null;
@callback_handle=null;
}
return true;
}

tts_voice@ tts_handle;
sound@ sound_handle;
int speech_output;
menu_callback@ callback_handle;
string callback_data;
bool running;
int menu_position;
dynamic_menu_item[] item_list;

int add_item_extended(string filename, bool is_filename, string name="", string key="", bool act=true)
{
if(running) return -1;
int new_index=item_list.length();
item_list.resize(new_index+1);
item_list[new_index].option=filename;
item_list[new_index].is_filename=is_filename;
item_list[new_index].name=name;
item_list[new_index].activate=act;
if(key=="")
{
key=filename[0];
key=string_to_lower_case(key);
}
item_list[new_index].letter=key;
return new_index+1;
}
}

funcdef int menu_callback(dynamic_menu_pro@, string);
