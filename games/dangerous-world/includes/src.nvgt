			f.set_disallowed_chars(mnz, disallowed_nums, false, "Numbers only.");
			f.set_disallowed_chars(mxz, disallowed_nums, false, "Numbers only.");

			cb_timed = f.create_checkbox("Use day and night time limits", saved_timed);
			s_sh = f.create_slider("start hour", saved_sh, 0, 23, "", 1);
			s_sm = f.create_slider("start minute", saved_sm, 0, 59, "", 1);
			s_eh = f.create_slider("end hour", saved_eh, 0, 23, "", 1);
			s_em = f.create_slider("end minute", saved_em, 0, 59, "", 1);
			s_fade = f.create_slider("fade duration in minutes", saved_fade, 0, 120, "", 5);

			cat_list = f.create_list("category");
			f.add_list_item(cat_list, "musics", "musics");
			f.add_list_item(cat_list, "sources", "sources");
			f.set_list_position(cat_list, saved_cat_pos, false);

			string sub_label = (saved_cat_pos == 0) ? "music sound" : "source sound";
			sub_list = f.create_list(sub_label);
			f.add_list_item(sub_list, "none", "none");
			if (saved_cat_pos == 0)
			{
				for (uint i = 0; i < musics_list.length(); i++) f.add_list_item(sub_list, musics_list[i], musics_list[i]);
			}
			else
			{
				for (uint i = 0; i < sources_list.length(); i++) f.add_list_item(sub_list, sources_list[i], sources_list[i]);
			}
			f.set_list_position(sub_list, saved_sub_pos, false);

			vol_s = f.create_slider("volume", saved_vol, -100, 0, "", 5);
			pit_s = f.create_slider("pitch", saved_pit, 5, 500, "", 5);
			ok = f.create_button("&okay", true);
			cn = f.create_button("&cancel");
			f.set_default_controls(ok, cn);

			if (last_cat_pos == -1) f.focus_silently(mx);
			else f.focus_silently(cat_list);
			last_cat_pos = saved_cat_pos;
		}

		f.monitor();

		bool is_t = f.is_checked(cb_timed);
		f.set_state(s_sh, is_t, is_t);
		f.set_state(s_sm, is_t, is_t);
		f.set_state(s_eh, is_t, is_t);
		f.set_state(s_em, is_t, is_t);
		f.set_state(s_fade, is_t, is_t);

		int cur_cat_pos = f.get_list_position(cat_list);
		if (cur_cat_pos != -1 && cur_cat_pos != last_cat_pos)
		{
			saved_cat_pos = cur_cat_pos;
			saved_sub_pos = 0;
			builder_preview_sound.close();
			preview_playing = false;
			do_build = true;
			continue;
		}

		int cur_focus = f.get_current_focus();
		bool in_group = (cur_focus == sub_list || cur_focus == vol_s || cur_focus == pit_s);
		int cur_sub_pos = f.get_list_position(sub_list);

		if (preview_playing && cur_sub_pos != last_sub_pos)
		{
			last_sub_pos = cur_sub_pos;
			if (cur_sub_pos > 0)
			{
				string snd_name = (saved_cat_pos == 0) ? musics_list[cur_sub_pos - 1] : sources_list[cur_sub_pos - 1];
				string path = (saved_cat_pos == 0) ? get_music_sound(snd_name) : get_ambience_sound(snd_name);
				preview_playing = play_builder_preview(path, f.get_slider(vol_s), f.get_slider(pit_s));
			}
			else
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
		}

		bool space_hit = key_pressed(KEY_SPACE) || (key_down(KEY_SPACE) && space_preview_timer.elapsed >= 300);
		if (space_hit && in_group)
		{
			space_preview_timer.restart();
			if (preview_playing)
			{
				builder_preview_sound.close();
				preview_playing = false;
			}
			else if (cur_sub_pos > 0)
			{
				string snd_name = (saved_cat_pos == 0) ? musics_list[cur_sub_pos - 1] : sources_list[cur_sub_pos - 1];
				string path = (saved_cat_pos == 0) ? get_music_sound(snd_name) : get_ambience_sound(snd_name);
				preview_playing = play_builder_preview(path, f.get_slider(vol_s), f.get_slider(pit_s));
			}
			last_sub_pos = cur_sub_pos;
		}

		if (builder_preview_sound.active)
		{
			builder_preview_sound.volume = f.get_slider(vol_s);
			builder_preview_sound.pitch = f.get_slider(pit_s);
		}

		if (key_pressed(KEY_ESCAPE) || f.is_pressed(cn))
		{
			builder_preview_sound.close();
			speak("canceled");
			return;
		}

		if (f.is_pressed(ok))
		{
			string tx = f.get_text(mx);
			string tx2 = f.get_text(mx2);
			string ty = f.get_text(my);
			string ty2 = f.get_text(my2);
			string tz = f.get_text(mnz);
			string tz2 = f.get_text(mxz);
			if (tx == "" || tx2 == "" || ty == "" || ty2 == "" || tz == "" || tz2 == "")
			{
				speak("Coordinates cannot be empty.");
				continue;
			}

			int p = f.get_list_position(sub_list);
			if (p <= 0)
			{
				speak("No sound selected. Please select a sound.");
				continue;
			}

			string bsub = (saved_cat_pos == 0) ? musics_list[p - 1] : sources_list[p - 1];
			if (bsub == "" || bsub == "none")
			{
				speak("No sound selected. Please select a sound.");
				continue;
			}

			int bx1 = int(string_to_number(tx));
			int bx2 = int(string_to_number(tx2));
			int by1 = int(string_to_number(ty));
			int by2 = int(string_to_number(ty2));
			int bz1 = int(string_to_number(tz));
			int bz2 = int(string_to_number(tz2));
			double bvol = f.get_slider(vol_s);
			double bpit = f.get_slider(pit_s);

			builder_preview_sound.close();
			if (f.is_checked(cb_timed))
			{
				int bsh = int(f.get_slider(s_sh));
				int bsm = int(f.get_slider(s_sm));
				int beh = int(f.get_slider(s_eh));
				int bem = int(f.get_slider(s_em));
				int bfade = int(f.get_slider(s_fade));
				save_to_map("ambience:" + bx1 + ":" + bx2 + ":" + by1 + ":" + by2 + ":" + bz1 + ":" + bz2 + ":" + bsub + ":" + bvol + ":" + bpit + ":1:" + bsh + ":" + bsm + ":" + beh + ":" + bem + ":" + bfade);
			}
			else
			{
				save_to_map("ambience:" + bx1 + ":" + bx2 + ":" + by1 + ":" + by2 + ":" + bz1 + ":" + bz2 + ":" + bsub + ":" + bvol + ":" + bpit);
			}
			return;
		}
	}
}
