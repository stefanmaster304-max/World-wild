void build_text_zone()
{
	string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";

	audio_form f;
	f.create_window("Add Text Zone", false, true, false);
	int i_minx = f.create_input_box("Minimum X", "" + minx);
	int i_maxx = f.create_input_box("Maximum X", "" + maxx);
	int i_miny = f.create_input_box("Minimum Y", "" + miny);
	int i_maxy = f.create_input_box("Maximum Y", "" + maxy);
	int i_minz = f.create_input_box("Minimum Z", "" + minz);
	int i_maxz = f.create_input_box("Maximum Z", "" + maxz);
	int i_text = f.create_input_box("Zone Name / Announcement", "Town Square");
	f.set_disallowed_chars(i_minx, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_maxx, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_miny, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_maxy, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_minz, "0123456789-", true, "Numbers only.");
	f.set_disallowed_chars(i_maxz, "0123456789-", true, "Numbers only.");
	int btn_ok = f.create_button("Add Zone", true);
	int btn_cancel = f.create_button("Cancel", false, true);
	f.set_default_controls(btn_ok, btn_cancel);
	f.focus_silently(i_text);

	int[] input_boxes = {i_minx, i_maxx, i_miny, i_maxy, i_minz, i_maxz, i_text};
	while (true)
	{
		wait(5);
		f.monitor();
		update_form_input_keyboard_sound(f, input_boxes);
		if (key_pressed(KEY_ESCAPE) || f.is_pressed(btn_cancel))
		{
			speak("canceled");
			return;
		}
		if (f.is_pressed(btn_ok))
		{
			string ztxt = f.get_text(i_text);
			if (ztxt == "")
			{
				speak("Zone name cannot be empty.");
				continue;
			}
			string tx1 = f.get_text(i_minx);
			string tx2 = f.get_text(i_maxx);
			string ty1 = f.get_text(i_miny);
			string ty2 = f.get_text(i_maxy);
			string tz1 = f.get_text(i_minz);
			string tz2 = f.get_text(i_maxz);
			if (tx1 == "" || tx2 == "" || ty1 == "" || ty2 == "" || tz1 == "" || tz2 == "")
			{
				speak("Coordinates cannot be empty.");
				continue;
			}
			save_to_map("zone:" + tx1 + ":" + tx2 + ":" + ty1 + ":" + ty2 + ":" + tz1 + ":" + tz2 + ":" + ztxt);
			return;
		}
	}
}
