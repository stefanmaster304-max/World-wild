bodyfall@[] bodyfalls(0);
class bodyfall
{
int btime=3000;
int x, y, z;
timer btimer;
bodyfall(int bx, int by, int bz, int bodytime=3000)
{
x=bx;
y=by;
z=bz;
btime=bodytime;
}
}
void bodyfallloop()
{
for (uint i=0; i<bodyfalls.length(); i++)
{
if (bodyfalls[i].btimer.elapsed>=bodyfalls[i].btime)
{
string btile = get_tile_at(bodyfalls[i].x, bodyfalls[i].y, bodyfalls[i].z);
p.play_3d(get_platform_sound(btile, "hardland"), me.x, me.y, me.z, bodyfalls[i].x, bodyfalls[i].y, bodyfalls[i].z, double(facing), false);
@bodyfalls[i]=null;
bodyfalls.remove_at(i);
i--;
continue;
}
}
}
void killbodyfalls()
{
bodyfalls.resize(0);
}
