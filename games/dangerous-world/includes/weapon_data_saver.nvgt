// weapon_data_saver.nvgt - Persistence and I/O for weapons.
// Unified encrypted format: settings/weapons.dat (all weapons encrypted into a single bundle)

const string WEAPON_ENC_KEY = "aB3!cD5#eF7@gH9*jK2$lM4^nP8&qR6%tS1*uV5/wX7(yZ0)zA3-dE6+fG9/hJ2=mL4+pO7*rT1_DWWeaponsPack2026";
const string WEAPON_DIR = "settings/weapons";
const string WEAPONS_DAT_PATH = "settings/weapons.dat";

string[] weapon_class_folders = {
	"pistols",
	"revolvers",
	"machine_guns",
	"rifles",
	"shotguns",
	"sniper_rifles",
	"melee",
	"launchers",
	"energy_weapons"
};


class weapon_data
{
	string id;
	string name;
	string description;
	string wclass;
	bool melee;
	int firetime;
	int firetime_min;
	int firetime_max;
	int walktime;
	int speedtime;
	int range;
	int min_damage;
	int max_damage;
	int spread;
	string ammo_type;
	string feed_device;
	int capacity;
	string reserve_item;
	string reserve_label;
	bool is_magazine;
	int starting_reserve;
	string ammo_display;
	string fire_modes;
	string sound_fire;
	string sound_distant_fire;
	string sound_ricochet;
	string sound_empty_mag;
	string sound_reload;
	string sound_draw;
	string sound_hit;

	weapon_data()
	{
		id = "";
		name = "";
		description = "";
		wclass = "rifles";
		melee = false;
		firetime = 500;
		firetime_min = 500;
		firetime_max = 500;
		walktime = 200;
		speedtime = 5;
		range = 10;
		min_damage = 50;
		max_damage = 100;
		spread = 0;
		ammo_type = "9x19mm Parabellum";
		feed_device = "magazine";
		capacity = 30;
		reserve_item = "";
		reserve_label = "magazine";
		is_magazine = true;
		starting_reserve = 3;
		ammo_display = "rounds";
		fire_modes = "semi";
		sound_fire = "";
		sound_distant_fire = "";
		sound_ricochet = "";
		sound_empty_mag = "";
		sound_reload = "";
		sound_draw = "";
		sound_hit = "";
	}

	weapon_data(const string&in wid, const string&in wname, const string&in cls = "rifles", int rng = 10, int min_dmg = 50, int max_dmg = 100, int ftime = 500, int cap = 30)
	{
		id = wid;
		name = wname;
		wclass = cls;
		melee = false;
		firetime = ftime;
		firetime_min = ftime;
		firetime_max = ftime;
		walktime = 200;
		speedtime = 5;
		range = (rng > 0) ? rng : 10;
		min_damage = min_dmg;
		max_damage = max_dmg;
		spread = 0;
		ammo_type = "9x19mm Parabellum";
		feed_device = "magazine";
		capacity = cap;
		reserve_item = "";
		reserve_label = "magazine";
		is_magazine = true;
		starting_reserve = 3;
		ammo_display = "rounds";
		fire_modes = "semi";
		sound_fire = "";
		sound_distant_fire = "";
		sound_ricochet = "";
		sound_empty_mag = "";
		sound_reload = "";
		sound_draw = "";
		sound_hit = "";
	}
}

weapon_data@[] weapon_registry(0);

bool weapons_loaded_once = false;
int weapon_cache_version = 0;
dictionary weapon_missing_cache;

void ensure_weapon_directories()
{
	if (!directory_exists("settings")) directory_create("settings");
	if (!directory_exists(WEAPON_DIR)) directory_create(WEAPON_DIR);
}

void parse_weapon_wpm(weapon_data@ w, const string&in content)
{
	string[]@ lines = string_split(content, "\n", true);
	if (lines is null) return;

	for (uint i = 0; i < lines.length(); i++)
	{
		string line = lines[i].trim_whitespace();
		if (line == "" || string_starts_with(line, "#") || string_starts_with(line, ";")) continue;
		int eq = string_contains(line, "=", 1);
		if (eq == -1) continue;

		string key = string_left(line, eq).trim_whitespace();
		string val = line.substr(eq + 1).trim_whitespace();

		if (key == "name") w.name = val;
		else if (key == "description") w.description = val;
		else if (key == "class") w.wclass = val;
		else if (key == "melee") w.melee = (val == "true" || val == "1");
		else if (key == "firetime") w.firetime = int(string_to_number(val));
		else if (key == "firetime_min") w.firetime_min = int(string_to_number(val));
		else if (key == "firetime_max") w.firetime_max = int(string_to_number(val));
		else if (key == "walktime") w.walktime = int(string_to_number(val));
		else if (key == "speedtime") w.speedtime = int(string_to_number(val));
		else if (key == "range") w.range = int(string_to_number(val));
		else if (key == "min_damage") w.min_damage = int(string_to_number(val));
		else if (key == "max_damage") w.max_damage = int(string_to_number(val));
		else if (key == "spread") w.spread = int(string_to_number(val));
		else if (key == "ammo_type") w.ammo_type = val;
		else if (key == "feed_device") w.feed_device = val;
		else if (key == "capacity") w.capacity = int(string_to_number(val));
		else if (key == "reserve_item") w.reserve_item = val;
		else if (key == "reserve_label") w.reserve_label = val;
		else if (key == "is_magazine") w.is_magazine = (val == "true" || val == "1");
		else if (key == "starting_reserve") w.starting_reserve = int(string_to_number(val));
		else if (key == "ammo_display") w.ammo_display = val;
		else if (key == "fire_modes") w.fire_modes = val;
		else if (key == "sound_fire") w.sound_fire = val;
		else if (key == "sound_distant_fire") w.sound_distant_fire = val;
		else if (key == "sound_ricochet") w.sound_ricochet = val;
		else if (key == "sound_empty_mag") w.sound_empty_mag = val;
		else if (key == "sound_reload") w.sound_reload = val;
		else if (key == "sound_draw") w.sound_draw = val;
		else if (key == "sound_hit") w.sound_hit = val;
	}
	if (w.firetime <= 0)
	{
		if (w.firetime_min > 0) w.firetime = w.firetime_min;
		else w.firetime = 500;
	}
	w.firetime_min = w.firetime;
	w.firetime_max = w.firetime;
	resolve_weapon_ammo_config(w);
}

void resolve_weapon_ammo_config(weapon_data@ w)
{
	if (w is null) return;
	if (w.melee)
	{
		w.ammo_type = "";
		w.reserve_item = "";
		w.reserve_label = "";
		w.capacity = 0;
		return;
	}

	string cls = string_to_lower_case(w.wclass);
	string nid = string_to_lower_case(w.id + " " + w.name);

	// If ammo_type is default or empty, infer realistic ammunition and container
