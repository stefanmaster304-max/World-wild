	{
		if (cls == "shotguns" || string_contains(nid, "shotgun", 1) > -1 || string_contains(nid, "maverick", 1) > -1 || string_contains(nid, "remington", 1) > -1 || string_contains(nid, "beneli", 1) > -1 || string_contains(nid, "ithica", 1) > -1)
