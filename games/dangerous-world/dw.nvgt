void dive_underwater()
{
	if (is_underwater) return;
	is_underwater = true;
	string dive_snd = get_platform_sound("deepwater", "fall");
	if (dive_snd == "") dive_snd = get_platform_sound("underwater", "fall");
	if (dive_snd != "") p.play_stationary(dive_snd, false);

	underwater_ambient_sound.stop();
	string uw_amb = get_sound_path("anbients/underwater.ogg;underwater.ogg");
	if (uw_amb != "" && underwater_ambient_sound.load(uw_amb))
	{
		underwater_ambient_sound.volume = ambient_volume - 100.0;
		underwater_ambient_sound.play_looped();
	}

}

void surface_from_underwater()
{
	if (!is_underwater) return;
	is_underwater = false;
	underwater_ambient_sound.stop();
	string surf_snd = get_platform_sound("deepwater", "land");
	if (surf_snd == "") surf_snd = get_platform_sound("underwater", "land");
	if (surf_snd != "") p.play_stationary(surf_snd, false);

}
timer movetimer, jumptimer, hittimer, healtimer;
timer idle_scuff_timer;
bool idle_scuff_primed=false;
bool idle_scuff_played=false;
int play_logo=1;
void play_logo_intro()
{
	if (play_logo != 1) return;
	string lpath = get_misc_sound("logo");
	if (lpath == "") lpath = get_sound_path("logo.ogg");
	if (!file_exists(lpath)) return;
	sound logosnd;
	if (logosnd.load(lpath))
	{
		logosnd.play();
		while(logosnd.playing)
		{
			wait(5);
			if (key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPAD_ENTER) or key_pressed(KEY_SPACE) or key_pressed(KEY_ESCAPE))
			{
				logosnd.stop();
				break;
			}
		}
	}
}
