void main()
{
	if (!directory_exists(prefsdir)) directory_create(prefsdir);
	readprefs();
	kb_init();
	load_maps_bundle();
	init_stores();
	load_all_items_config();
	load_all_packages();
	register_default_shield_if_missing();
	register_default_anti_death_card_if_missing();
	load_all_weapons_wpm();

show_window("Dangerous World! Version "+ver);
wait(100);
if (!verify_files()) exit();
play_logo_intro();
if (directory_exists(DIRECTORY_TEMP+"/cheat engine") and SCRIPT_COMPILED)
{
sound cheater;
string cpath = get_misc_sound("cheat");
if (cpath == "") cpath = get_sound_path("cheat.ogg");
cheater.load(cpath);
cheater.play_wait();
exit();
}
if (!file_exists(prefsdir+"/settings.dat"))
{
dlg("Settings file not found, creating a new settings file...");
}
	p.volume_step = 2.0;
	sp.volume_step = 2.0;
	itempool.volume_step = 2.0;
	dp.volume_step = 2.0;
	spool.volume_step = 2.0;
	dp.pan_step = 1.0;
	dp.behind_pitch_decrease = 0.0;
	// Max audible radius for pools
	dp.max_distance = 80;
p.pan_step = 1.0;
sp.pan_step = 1.0;
itempool.pan_step = 1.0;
dp.pan_step = 1.0;
spool.pan_step = 1.0;
p.behind_pitch_decrease = 0.0;
sp.behind_pitch_decrease = 0.0;
