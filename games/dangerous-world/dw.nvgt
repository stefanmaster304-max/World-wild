double get_xp_required(int lvl)
{
	if (lvl <= 1) return 100.0;
	return double(lvl * 100.0);
}

// Keeps XP local to the current level and resets XP toward the next level limit.
void normalize_player_xp(bool announce = false)
{
	if(level < 1) level = 1;
	if(xp < 0) xp = 0;
	int old_level = level;
	int max_level = get_resurrection_levels_required(resurrections);
	xprequired = get_xp_required(level);
	while(level < max_level && xp >= xprequired)
	{
		xp -= xprequired;
		if (xp < 0) xp = 0;
		level++;
		xprequired = get_xp_required(level);
	}
	if(announce && level > old_level)
	{
		speak("You are now at level " + level + ".");
		string level_sound = get_player_sound("levelup");
		if (sound_file_exists(level_sound)) p.play_stationary(level_sound, false);
	}
}

int get_resurrection_levels_required(int r)
{
	return 2500;
}

double xprequired=50;

void add_player_quantum_xp(int amount)
{
    if (amount <= 0) return;
    xp += amount;
    normalize_player_xp(true);
}
string mapname;
