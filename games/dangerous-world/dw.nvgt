bool confirm_exit_dialog()
{
	speak("Are you sure you want to exit? Press Y or Enter for Yes, or Escape to cancel.");
	while (true)
	{
		wait(5);
		update_game_world();
		if (key_pressed(KEY_Y) || key_pressed(KEY_RETURN) || key_pressed(KEY_NUMPAD_ENTER) || key_pressed(KEY_NUMPADENTER) || kb_pressed("menu_confirm") || kb_pressed("menu_activate") || kb_pressed("use"))
		{
			return true;
		}
		if (key_pressed(KEY_ESCAPE) || key_pressed(KEY_N) || kb_pressed("menu_back") || kb_pressed("exit_game"))
		{
			speak("Canceled.");
			return false;
		}
		if (key_pressed(KEY_UP) || key_pressed(KEY_DOWN) || key_pressed(KEY_LEFT) || key_pressed(KEY_RIGHT) || key_pressed(KEY_SPACE))
		{
			speak("Are you sure you want to exit? Press Y or Enter for Yes, or Escape to cancel.");
		}
	}
	return false;
}
// Toggles the player between sitting and standing (Q key).
void toggle_sit_stand()
{
	if (is_sitting)
	{
		is_sitting = false;
		string snd = get_sound_path("standup.ogg");
		if (snd != "") p.play_stationary(snd, false);
		speak("You stand up.");
	}
	else
	{
		is_sitting = true;
		string snd = get_sound_path("sitdown.ogg");
		if (snd != "") p.play_stationary(snd, false);
		string platform = gmt();
		string fall_snd = get_platform_sound(platform, "fall");
		if (fall_snd != "") p.play_stationary(fall_snd, false);
		speak("You sit down.");
	}
}
