bullet@[] bullets(0);
class bullet
{
int distance;
int sx, sy;
int x, y;
int facing;
int range;
int speed=20;
timer speedtimer;
bullet(int r, int s1, int s2,int fa,int sp)
{
speed=sp;
facing=fa;
sx=s1;
sy=s2;
x=s1;
y=s2;
range=r;
}
}
void bulletloop()
{
for (uint i=0; i<bullets.length(); i++)
{
if (bullets[i].facing==Left and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].x-=1;
bullets[i].distance+=1;
bulletcheck(i);
}
else if (bullets[i].facing==Right and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].x+=1;
bullets[i].distance+=1;
bulletcheck(i);
}
else if (bullets[i].facing==Forward and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].y+=1;
bullets[i].distance+=1;
bulletcheck(i);
}
else if (bullets[i].facing==Backward and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].y-=1;
bullets[i].distance+=1;
bulletcheck(i);
}
}
}
void bulletcheck(int b)
{
string surface=get_platform_at(bullets[b].x,bullets[b].y,me.z);
if (surface=="" or string_contains(surface,"wall",1)>-1)
{
if (melee==false) p.play_3d(game_audio_path("bulletrico"+random(1,3)+".ogg"),me.x,me.y,me.z,bullets[b].x,bullets[b].y,me.z,false);
bullets.remove_at(b);
return;
}
if (bullets[b].distance>=bullets[b].range)
{
if (melee==false) p.play_3d(game_audio_path("bulletshell"+random(1,3)+".ogg"),me.x,me.y,me.z,bullets[b].x,bullets[b].y,me.z,false);
bullets.remove_at(b);
return;
}
}
void spawn_bullet(int range,int x,int y,int direction,int speed)
{
bullet b1(range,x,y,direction,speed);
bullets.insert_last(b1);
bulletcheck(bullets.length()-1);
}
