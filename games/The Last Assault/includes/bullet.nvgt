bullet@[] bullets(0);
class bullet
{
int distance;
int sx, sy;
int x, y;
int facing;
int range;
int damage;
int speed=20;
timer speedtimer;
bullet(int d, int r, int s1, int s2,int fa,int sp)
{
speed=sp;
facing=fa;
sx=s1;
sy=s2;
x=s1;
y=s2;
damage=d;
range=r;
}
}
void bulletloop()
{
for (uint i=0; i<bullets.length(); i++)
{
if (bullets[i].facing==Left and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].x-=1;
bullets[i].distance+=1;
if (bullets[i].damage>2)
bullets[i].damage-=1;
bulletcheck(i);
}
else if (bullets[i].facing==Right and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].x+=1;
bullets[i].distance+=1;
if (bullets[i].damage>2)
bullets[i].damage-=1;
bulletcheck(i);
}
else if (bullets[i].facing==Forward and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].y+=1;
bullets[i].distance+=1;
if (bullets[i].damage>2)
bullets[i].damage-=1;
bulletcheck(i);
}
else if (bullets[i].facing==Backward and bullets[i].speedtimer.elapsed>=bullets[i].speed)
{
bullets[i].speedtimer.restart();
bullets[i].y-=1;
bullets[i].distance+=1;
if (bullets[i].damage>2)
bullets[i].damage-=1;
bulletcheck(i);
}
}
}
void bulletcheck(int b)
{
string surface=get_platform_at(bullets[b].x,bullets[b].y,0);
if (surface=="" or string_contains(surface,"wall",1)>-1)
{
if (melee==false) p.play_3d(game_audio_path("bulletrico"+random(1,3)+".ogg"),me.x,me.y,me.z,bullets[b].x,bullets[b].y,0,false);
bullets.remove_at(b);
return;
}
if (bullets[b].distance>=bullets[b].range)
{
if (melee==false) p.play_3d(game_audio_path("bulletshell"+random(1,3)+".ogg"),me.x,me.y,me.z,bullets[b].x,bullets[b].y,0,false);
bullets.remove_at(b);
return;
}
for (uint i=0; i<enemies.length(); i++)
{
if (enemies[i].x==bullets[b].x and enemies[i].y==bullets[b].y and me.z==enemies[i].z and get_safe_zone_at(enemies[i].x,enemies[i].y,enemies[i].z)=="")
{
enemies[i].hp-=bullets[b].damage;
p.play_3d(game_audio_path(weaponname+"hit"+random(1,3)+".ogg"),me.x,me.y,me.z,enemies[i].x,enemies[i].y,enemies[i].z,false);
p.play_3d(game_audio_path("e"+enemies[i].type+"hit"+random(1,3)+".ogg"),me.x,me.y,me.z,enemies[i].x,enemies[i].y,enemies[i].z,false);
if (scatter==false)
{
bullets.remove_at(b);
break;
}
}
}
}
void spawn_bullet(int p1, int p2, int p3, int p4, int p5,int p6)
{
bullet b1(p1,p2,p3,p4,p5,p6);
bullets.insert_last(b1);
bulletcheck(bullets.length()-1);
}
