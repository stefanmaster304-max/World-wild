settings game_config;
string game_language = "en";
bool menu_wrap_enabled = true;
timer player_save_timer;

string[] language_keys;
string[] language_values;

string decode_language_field(const string&in value)
{
	return string_replace(value,"\\s"," ",true);
}

bool load_language_file(const string&in language_code)
{
	language_keys.resize(0);
	language_values.resize(0);
	file language_file;
	if(!language_file.open("languages/"+language_code+".lang","rb")) return false;
	string content=string_replace(language_file.read(),"\r","",true);
	language_file.close();
	string[] lines=string_split(content,"\n",false);
	for(uint i=0;i<lines.length();i++)
	{
		int separator=lines[i].find_first("\t");
		if(separator<1) continue;
		language_keys.insert_last(decode_language_field(lines[i].substr(0,separator)));
		language_values.insert_last(decode_language_field(lines[i].substr(separator+1)));
	}
	return language_keys.length()>0;
}

string tr_catalog(const string&in key)
{
	for(uint i=0;i<language_keys.length();i++)
		if(language_keys[i]==key) return language_values[i];
	return "";
}

string tr(const string&in source)
{
	string translation=tr_catalog(source);
	return translation=="" ? source : translation;
}

string tr_apply(string text,const string&in token,const string&in value)
{
	return string_replace(text,"{"+token+"}",value,true);
}

string tr_menu_position(int position, int count)
{
	string result=tr_catalog("@menu_position");
	if(result=="") result=". {position} of {count}";
	result=tr_apply(result,"position",position+"");
	return tr_apply(result,"count",count+"");
}

string tr_percent(int value)
{
	string result=tr_catalog("@percent");
	if(result=="") result="{value} percent";
	return tr_apply(result,"value",value+"");
}

string tr_ammunition_status(int ammo_count, int clip_count)
{
	string result=tr_catalog("@ammo_status");
	if(result=="") result="{ammo} ammo loaded, {clips} clips left.";
	result=tr_apply(result,"ammo",ammo_count+"");
	return tr_apply(result,"clips",clip_count+"");
}

string tr_level_status(int current_level, double current_xp, double xp_needed, int next_level)
{
	string result=tr_catalog("@level_status");
	if(result=="") result="You are level {level} with {xp} experience. You need {remaining} experience to get to level {next}.";
	result=tr_apply(result,"level",current_level+"");
	result=tr_apply(result,"xp",current_xp+"");
	result=tr_apply(result,"remaining",xp_needed+"");
	return tr_apply(result,"next",next_level+"");
}

string tr_weapon_name(const string&in weapon_id)
{
	string result=tr_catalog("@weapon."+weapon_id);
	return result=="" ? weapon_id : result;
}

string tr_selected_floor(const string&in floor_name)
{
	string result=tr_catalog("@selected_floor");
	if(result=="") result="{name} selected as the map floor.";
	return tr_apply(result,"name",floor_name);
}

string tr_selected_item(const string&in item_name)
{
	string result=tr_catalog("@selected_item");
	if(result=="") result="{name} selected.";
	return tr_apply(result,"name",item_name);
}

string tr_inventory_item(const string&in item_id)
{
	string result=tr_catalog("@item."+item_id);
	return result=="" ? item_id : result;
}

string tr_inventory_status(int amount, const string&in item_id, int position, int total)
{
	string item_name=tr_inventory_item(item_id);
	if(amount>1) item_name=amount+" "+item_name;
	return item_name+tr_menu_position(position,total);
}

void initialize_game_storage()
{
	game_config.setup("StefanGames", "The Last Assault", false);
	if(game_config.exists("language")) game_language=game_config.read_string("language");
	if(game_language!="en" && game_language!="pt" && game_language!="es" && game_language!="tr" && game_language!="vi") game_language="en";
	if(!load_language_file(game_language)) { game_language="en"; load_language_file("en"); }
	if(game_config.exists("menu_wrap")) menu_wrap_enabled=game_config.read_number("menu_wrap")!=0;
	if(!game_config.exists("level"))
	{
		game_config.write_number("level",1); game_config.write_number("xp",0);
		game_config.write_number("health",100); game_config.write_number("map_music_gain",1.0);
		game_config.write_number("master_volume_gain",1.0);
	}
	else if(game_config.read_number("health")<=0) game_config.write_number("health",100);
}

void save_player_properties()
{
	game_config.write_number("level",level); game_config.write_number("xp",xp);
	game_config.write_number("health",health>0 ? health : 100); game_config.write_string("map",mapname);
	game_config.write_number("x",me.x); game_config.write_number("y",me.y); game_config.write_number("z",me.z);
}
