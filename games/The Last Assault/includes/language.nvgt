string tr_menu_position(int position, int count)
{
	if(game_language=="pt" || game_language=="es") return ". "+position+" de "+count;
	if(game_language=="tr") return ". "+position+" / "+count;
	if(game_language=="vi") return ". "+position+" trên "+count;
	return ". "+position+" of "+count;
}

string tr_percent(int value)
{
	if(game_language=="pt") return value+" por cento";
	if(game_language=="es") return value+" por ciento";
	if(game_language=="tr") return "yüzde "+value;
	if(game_language=="vi") return value+" phần trăm";
	return value+" percent";
}

string tr_ammunition_status(int ammo_count, int clip_count)
{
	if(game_language=="pt") return ammo_count+" munições carregadas, "+clip_count+" carregadores restantes.";
	if(game_language=="es") return ammo_count+" balas cargadas, quedan "+clip_count+" cargadores.";
	if(game_language=="tr") return ammo_count+" mermi yüklü, "+clip_count+" şarjör kaldı.";
	if(game_language=="vi") return "Đã nạp "+ammo_count+" viên đạn, còn "+clip_count+" băng đạn.";
	return ammo_count+" ammo loaded, "+clip_count+" clips left.";
}

string tr_level_status(int current_level, double current_xp, double xp_needed, int next_level)
{
	if(game_language=="pt") return "Você está no nível "+current_level+" com "+current_xp+" de experiência. Precisa de mais "+xp_needed+" de experiência para chegar ao nível "+next_level+".";
	if(game_language=="es") return "Estás en el nivel "+current_level+" con "+current_xp+" de experiencia. Necesitas "+xp_needed+" más para llegar al nivel "+next_level+".";
	if(game_language=="tr") return current_level+". seviyedesiniz ve "+current_xp+" deneyiminiz var. "+next_level+". seviyeye ulaşmak için "+xp_needed+" deneyim daha gerekli.";
	if(game_language=="vi") return "Bạn đang ở cấp "+current_level+" với "+current_xp+" điểm kinh nghiệm. Cần thêm "+xp_needed+" điểm để đạt cấp "+next_level+".";
	return "You are level "+current_level+" with "+current_xp+" experience. You need "+xp_needed+" experience to get to level "+next_level+".";
}

string tr_enemy_count(uint enemy_total)
{
	if(game_language=="pt") return enemy_total+" inimigos no mapa.";
	if(game_language=="es") return enemy_total+" enemigos en el mapa.";
	if(game_language=="tr") return "Haritada "+enemy_total+" düşman var.";
	if(game_language=="vi") return "Có "+enemy_total+" kẻ địch trên bản đồ.";
	return enemy_total+" enemies are on the map.";
}

string tr_weapon_name(const string&in weapon_id)
{
	if(weapon_id=="fists")
	{
		if(game_language=="pt") return "Punhos"; if(game_language=="es") return "Puños";
		if(game_language=="tr") return "Yumruklar"; if(game_language=="vi") return "Nắm đấm";
	}
	if(weapon_id=="handgun")
	{
		if(game_language=="pt") return "Pistola"; if(game_language=="es") return "Pistola";
		if(game_language=="tr") return "Tabanca"; if(game_language=="vi") return "Súng ngắn";
	}
	if(weapon_id=="machinegun")
	{
		if(game_language=="pt") return "Metralhadora"; if(game_language=="es") return "Ametralladora";
		if(game_language=="tr") return "Makineli tüfek"; if(game_language=="vi") return "Súng máy";
	}
	return weapon_id;
}

string tr_selected_floor(const string&in floor_name)
{
	if(game_language=="pt") return floor_name+" selecionado como piso do mapa.";
	if(game_language=="es") return floor_name+" seleccionada como suelo del mapa.";
	if(game_language=="tr") return floor_name+" harita zemini olarak seçildi.";
	if(game_language=="vi") return "Đã chọn "+floor_name+" làm nền bản đồ.";
	return floor_name+" selected as the map floor.";
}

string tr_selected_item(const string&in item_name)
{
	if(game_language=="pt") return item_name+" selecionado.";
	if(game_language=="es") return item_name+" seleccionado.";
	if(game_language=="tr") return item_name+" seçildi.";
	if(game_language=="vi") return "Đã chọn "+item_name+".";
	return item_name+" selected.";
}

string tr_inventory_item(const string&in item_id)
{
	if(item_id=="handgun ammo")
	{
		if(game_language=="pt") return "munição de pistola"; if(game_language=="es") return "munición de pistola";
		if(game_language=="tr") return "tabanca mermisi"; if(game_language=="vi") return "đạn súng ngắn";
	}
	if(item_id=="handgun clip")
	{
		if(game_language=="pt") return "carregador de pistola"; if(game_language=="es") return "cargador de pistola";
		if(game_language=="tr") return "tabanca şarjörü"; if(game_language=="vi") return "băng đạn súng ngắn";
	}
	if(item_id=="medkit")
	{
		if(game_language=="pt") return "kit médico"; if(game_language=="es") return "botiquín";
		if(game_language=="tr") return "ilk yardım çantası"; if(game_language=="vi") return "bộ sơ cứu";
	}
	if(item_id=="Energy potion" || item_id=="Energy_potion")
	{
		if(game_language=="pt") return "poção de energia"; if(game_language=="es") return "poción de energía";
		if(game_language=="tr") return "enerji iksiri"; if(game_language=="vi") return "thuốc năng lượng";
	}
	return item_id;
}

string tr_inventory_status(int amount, const string&in item_id, int position, int total)
{
	string item_name=tr_inventory_item(item_id);
	if(amount<=1) return item_name+tr_menu_position(position,total);
	if(game_language=="pt") return amount+" "+item_name+tr_menu_position(position,total);
	if(game_language=="es") return amount+" "+item_name+tr_menu_position(position,total);
	if(game_language=="tr") return amount+" "+item_name+tr_menu_position(position,total);
	if(game_language=="vi") return amount+" "+item_name+tr_menu_position(position,total);
	return amount+" "+item_name+tr_menu_position(position,total);
}

void initialize_game_storage()
{
	game_config.setup("StefanGames", "The Last Assault", false);
	if(game_config.exists("language")) game_language=game_config.read_string("language");
	if(game_language!="en" && game_language!="pt" && game_language!="es" && game_language!="tr" && game_language!="vi") game_language="en";
	if(game_config.exists("menu_wrap")) menu_wrap_enabled=game_config.read_number("menu_wrap")!=0;
	if(!game_config.exists("level"))
	{
		game_config.write_number("level",1); game_config.write_number("xp",0);
		game_config.write_number("health",100); game_config.write_number("map_music_gain",1.0);
		game_config.write_number("master_volume_gain",1.0);
	}
}

void save_player_properties()
{
	game_config.write_number("level",level); game_config.write_number("xp",xp);
	game_config.write_number("health",health); game_config.write_string("map",mapname);
	game_config.write_number("x",me.x); game_config.write_number("y",me.y); game_config.write_number("z",me.z);
}
