#include "zone.nvgt"
#include "safe_zone.nvgt"

const int MAP_FLAG_PLATFORM = 1;
const int Left=1;
const int Right=2;
const int Backward=3;
const int Forward=4;
const int Up=5;
const int Down=6;
coordinate_map map_index;
string mapname = "";
string[] current_map_lines;
int map_min_x, map_max_x, map_min_y, map_max_y, map_min_z, map_max_z;
int map_area_priority = 0;
bool playwall = false;

class map_travel_point
{
	int minx, maxx, miny, maxy, minz, maxz;
	int dest_minx,dest_maxx,dest_miny,dest_maxy,dest_minz,dest_maxz;
	string destination;
	map_travel_point(int x1,int x2,int y1,int y2,int z1,int z2,int dx1,int dx2,int dy1,int dy2,int dz1,int dz2,const string&in target)
	{
		minx=x1; maxx=x2; miny=y1; maxy=y2; minz=z1; maxz=z2;
		dest_minx=(dx1<=dx2) ? dx1 : dx2; dest_maxx=(dx1<=dx2) ? dx2 : dx1;
		dest_miny=(dy1<=dy2) ? dy1 : dy2; dest_maxy=(dy1<=dy2) ? dy2 : dy1;
		dest_minz=(dz1<=dz2) ? dz1 : dz2; dest_maxz=(dz1<=dz2) ? dz2 : dz1;
		destination=target;
	}
	bool contains(int x, int y, int z) const
	{
		bool z_inside=(minz==maxz) ? (z>=minz-1 && z<=maxz+3) : (z>=minz-1 && z<=maxz+6);
		return x>=minx && x<=maxx && y>=miny && y<=maxy && z_inside;
	}
	void get_destination_coords(int player_x,int player_y,int&out x,int&out y,int&out z) const
	{
		if(dest_minx==dest_maxx || maxx==minx) x=dest_minx;
		else
		{
			double ratio=double(player_x-minx)/double(maxx-minx);
			if(ratio<0.0) ratio=0.0;
			if(ratio>1.0) ratio=1.0;
			x=dest_minx+int(round(ratio*double(dest_maxx-dest_minx),0));
		}
		if(dest_miny==dest_maxy || maxy==miny) y=dest_miny;
		else
		{
			double ratio=double(player_y-miny)/double(maxy-miny);
			if(ratio<0.0) ratio=0.0;
			if(ratio>1.0) ratio=1.0;
			y=dest_miny+int(round(ratio*double(dest_maxy-dest_miny),0));
		}
		z=dest_minz;
	}
}

map_travel_point@[] map_travel_points;

void clear_map_data()
{
	map_index.reset();
	bullets.resize(0);
	p.destroy_all();
	map_area_priority=0;
	map_travel_points.resize(0);
	current_map_lines.resize(0);
	mapname="";
	clear_map_zones();
	clear_map_safe_zones();
	destroy_all_staircases();
	killsrcs();
	playwall=false;
	currentloc="";
}

void spawn_platform(int minx, int maxx, int miny, int maxy, int minz, int maxz, const string&in type)
{
	map_index.add_area(minx, maxx, miny, maxy, minz, maxz, 0.0, null, type, "", "", map_area_priority++, MAP_FLAG_PLATFORM);
}

void spawn_zone(int minx, int maxx, int miny, int maxy, int minz, int maxz, const string&in label)
{
	add_map_zone(minx, maxx, miny, maxy, minz, maxz, label);
}

void spawn_safe_zone(int minx, int maxx, int miny, int maxy, int minz, int maxz, const string&in label="Safe zone")
{
	add_map_safe_zone(minx, maxx, miny, maxy, minz, maxz, label);
}

void add_map_travel_point(int minx,int maxx,int miny,int maxy,int minz,int maxz,const string&in destination,int dx1,int dx2,int dy1,int dy2,int dz1,int dz2)
{
	map_travel_point point(minx,maxx,miny,maxy,minz,maxz,dx1,dx2,dy1,dy2,dz1,dz2,destination);
	map_travel_points.insert_last(point);
}

map_travel_point@ get_travel_point_at(int x, int y, int z)
{
	for(uint i=0;i<map_travel_points.length();i++)
		if(map_travel_points[i].contains(x,y,z)) return map_travel_points[i];
	return null;
}

string map_file_path(const string&in name)
{
	return "maps/" + name + ".map";
}

bool valid_map_name(const string&in name)
{
	if (name.trim_whitespace()=="") return false;
	for (uint i=0; i<name.length(); i++)
	{
		string c=name.substr(i,1);
		if (!(c>="a" && c<="z") && !(c>="A" && c<="Z") && !(c>="0" && c<="9") && c!=" " && c!="_" && c!="-") return false;
	}
	return true;
}

bool map_exists(const string&in name)
{
	return valid_map_name(name) && file_exists(map_file_path(name));
}

string[] available_map_names()
{
	string[] names;
	string[]@ files=find_files("maps/*.map");
	if (files is null) return names;
	for (uint i=0; i<files.length(); i++)
	{
		string filename=string_replace(files[i], "\\", "/", true);
		int slash=filename.find_last("/");
		if (slash>=0) filename=filename.substr(slash+1);
		if (filename.length()<=4 || filename.substr(filename.length()-4)!=".map") continue;
		string name=filename.substr(0,filename.length()-4);
		if (valid_map_name(name)) names.insert_last(name);
	}
	return names;
}

bool save_map_lines(const string&in name, string[]&in lines)
{
	if (!valid_map_name(name)) return false;
	if (!directory_exists("maps") && !directory_create("maps")) return false;
	file output;
	if (!output.open(map_file_path(name), "wb")) return false;
	for (uint i=0; i<lines.length(); i++) output.write(lines[i] + "\r\n");
	output.close();
	return true;
}

string get_platform_at(int x, int y, int z)
{
	coordinate_map_area@ area=map_index.get_area(x, y, z, -1, 0.0, null, MAP_FLAG_PLATFORM);
	if (@area is null) return "";
	return area.data1;
}

void announce_current_zone()
{
	string zone_name=get_zone_at(me.x,me.y,me.z);
	if(zone_name=="") game_speak(tr("Area unknown"));
	else game_speak(zone_name);
	currentloc=zone_name;
	location_announced=true;
}

void playstep()
{
	string tile=get_platform_at(me.x, me.y, me.z);
	if (tile=="") return;
	if (string_contains(tile, "wall", 1)>-1)
	{
		if (!playwall) p.play_stationary(game_audio_path(tile+".ogg"), false);
		playwall=true;
		bounce();
		return;
	}
	p.play_stationary(game_audio_path(tile+"step"+random(1,5)+".ogg"), false);
	playwall=false;
}

void bounce()
{
	if (facing==Left) me.x++;
	else if (facing==Right) me.x--;
	else if (facing==Forward) me.y--;
	else if (facing==Backward) me.y++;
}

bool load_map(const string&in name,bool move_to_minimum=false,int start_x=0,int start_y=0,int start_z=0)
{
	if (!valid_map_name(name) || !file_exists(map_file_path(name))) return false;
	file input;
	if (!input.open(map_file_path(name), "rb")) return false;
	string content=input.read();
	input.close();
	int old_x=me.x,old_y=me.y,old_z=me.z;
	content=string_replace(content, "\r", "", true);
	string[] lines=string_split(content, "\n", false);
	if (lines.length()==0) return false;

	clear_map_data();
	mapname=name;
	if(move_to_minimum) { me.x=start_x; me.y=start_y; me.z=start_z; }
	location_announced=false;
	currentloc="";
	map_min_x=0; map_min_y=0; map_min_z=0;
	map_max_x=0; map_max_y=0; map_max_z=0;
	bool has_min_x=false,has_max_x=false,has_min_y=false,has_max_y=false,has_min_z=false,has_max_z=false;
	int loaded_records=0;

	for (uint i=0; i<lines.length(); i++)
	{
		string line=lines[i].trim_whitespace();
		if (line=="" || string_left(line,1)=="#" || string_left(line,1)==";") continue;
		current_map_lines.insert_last(line);
		string[] fields=string_split(line, ":", false);
		if (fields.length()==0) continue;
		string command=string_to_lower_case(fields[0].trim_whitespace());
		if (command=="name" || command=="map") continue;
		if (command=="bounds" && fields.length()>=7)
		{
			map_min_x=string_to_number(fields[1]); map_max_x=string_to_number(fields[2]);
			map_min_y=string_to_number(fields[3]); map_max_y=string_to_number(fields[4]);
			map_min_z=string_to_number(fields[5]); map_max_z=string_to_number(fields[6]);
			has_min_x=true;has_max_x=true;has_min_y=true;has_max_y=true;has_min_z=true;has_max_z=true;
			maxx=map_max_x; maxy=map_max_y;
			continue;
		}
		if(fields.length()>=2 && (command=="minx" || command=="maxx" || command=="miny" || command=="maxy" || command=="minz" || command=="maxz"))
		{
			int value=int(string_to_number(fields[1]));
			if(command=="minx") { map_min_x=value; has_min_x=true; }
			else if(command=="maxx") { map_max_x=value; has_max_x=true; maxx=value; }
			else if(command=="miny") { map_min_y=value; has_min_y=true; }
			else if(command=="maxy") { map_max_y=value; has_max_y=true; maxy=value; }
			else if(command=="minz") { map_min_z=value; has_min_z=true; }
			else { map_max_z=value; has_max_z=true; }
			continue;
		}
		if (command=="platform" && fields.length()>=8)
		{
			spawn_platform(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),fields[7]);
			loaded_records++;
		}
		else if (command=="zone" && fields.length()>=8)
		{
			spawn_zone(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),fields[7]);
			loaded_records++;
		}
		else if (command=="safezone" && fields.length()>=7)
		{
			string label=(fields.length()>=8) ? fields[7] : "Safe zone";
			spawn_safe_zone(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),label);
			loaded_records++;
		}
		else if (command=="staircase" && fields.length()>=8)
		{
			spawn_staircase(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),fields[7]);
			loaded_records++;
		}
		else if ((command=="source" || command=="src") && fields.length()>=8)
		{
			bool legacy_tagged=fields.length()>=9 && (fields[7]=="music" || fields[7]=="sources");
			bool standard_tagged=fields.length()>=11 && (fields[10]=="music" || fields[10]=="sources");
			string audio_file=legacy_tagged ? fields[8] : fields[7];
			float audio_gain=legacy_tagged ? float(string_to_number(fields[9])) : (fields.length()>=9 ? float(string_to_number(fields[8])) : 1.0);
			float audio_pitch=legacy_tagged ? float(string_to_number(fields[10])) : (fields.length()>=10 ? float(string_to_number(fields[9])) : 100.0);
			bool is_music=legacy_tagged ? fields[7]=="music" : (standard_tagged ? fields[10]=="music" : is_music_audio_asset(audio_file));
			spawn_source(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),game_audio_path(audio_file),audio_gain,audio_pitch,is_music);
			loaded_records++;
		}
		else if ((command=="ambient" || command=="ambience") && fields.length()>=8)
		{
			bool legacy_tagged=fields.length()>=9 && (fields[7]=="music" || fields[7]=="sources");
			bool standard_tagged=fields.length()>=11 && (fields[10]=="music" || fields[10]=="sources");
			string audio_file=legacy_tagged ? fields[8] : fields[7];
			float audio_gain=legacy_tagged ? float(string_to_number(fields[9])) : (fields.length()>=9 ? float(string_to_number(fields[8])) : 1.0);
			float audio_pitch=legacy_tagged ? float(string_to_number(fields[10])) : (fields.length()>=10 ? float(string_to_number(fields[9])) : 100.0);
			bool is_music=legacy_tagged ? fields[7]=="music" : (standard_tagged ? fields[10]=="music" : is_music_audio_asset(audio_file));
			spawn_ambient_source(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),game_audio_path(audio_file),audio_gain,audio_pitch,is_music);
			loaded_records++;
		}
		else if (command=="travelpoint" && fields.length()>=11)
		{
			if(fields.length()>=14)
				add_map_travel_point(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),fields[7],string_to_number(fields[8]),string_to_number(fields[9]),string_to_number(fields[10]),string_to_number(fields[11]),string_to_number(fields[12]),string_to_number(fields[13]));
			else
				add_map_travel_point(string_to_number(fields[1]),string_to_number(fields[2]),string_to_number(fields[3]),string_to_number(fields[4]),string_to_number(fields[5]),string_to_number(fields[6]),fields[7],string_to_number(fields[8]),string_to_number(fields[8]),string_to_number(fields[9]),string_to_number(fields[9]),string_to_number(fields[10]),string_to_number(fields[10]));
			loaded_records++;
		}
	}
	if (!has_min_x || !has_max_x || !has_min_y || !has_max_y || !has_min_z || !has_max_z || loaded_records==0)
	{
		clear_map_data();
		me.x=old_x; me.y=old_y; me.z=old_z;
		return false;
	}
	return true;
}

bool travel_at_player()
{
	if (!altisdown() || !key_pressed(KEY_RETURN)) return false;
	map_travel_point@ target=get_travel_point_at(me.x,me.y,me.z);
	if (@target is null)
	{
		game_speak("There is no travel point here.");
		return true;
	}
	string destination=target.destination;
	int destination_x,destination_y,destination_z;
	target.get_destination_coords(me.x,me.y,destination_x,destination_y,destination_z);
	if (!load_map(destination,true,destination_x,destination_y,destination_z))
	{
		game_speak(tr("The destination map ")+destination+tr(" could not be loaded."));
		return true;
	}
	currentloc="";
	game_speak(tr("Traveling to ")+mapname+".");
	return true;
}

void map_audio_update()
{
	sp.update_listener_3d(me.x, me.y, me.z);
	update_map_audio(me.x, me.y, me.z);
}
