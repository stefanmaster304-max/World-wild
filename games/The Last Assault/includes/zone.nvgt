class map_zone
{
	int minx, maxx, miny, maxy, minz, maxz;
	string label;
	map_zone(int x1, int x2, int y1, int y2, int z1, int z2, const string&in name)
	{
		minx=x1; maxx=x2; miny=y1; maxy=y2; minz=z1; maxz=z2; label=name;
	}
	bool contains(int x, int y, int z) const
	{
		return x>=minx && x<=maxx && y>=miny && y<=maxy && z>=minz && z<=maxz;
	}
}

map_zone@[] map_zones;

void clear_map_zones()
{
	map_zones.resize(0);
}

void add_map_zone(int minx, int maxx, int miny, int maxy, int minz, int maxz, const string&in label)
{
	map_zone zone(minx, maxx, miny, maxy, minz, maxz, label);
	map_zones.insert_last(zone);
}

string get_zone_at(int x, int y, int z)
{
	for (int i=int(map_zones.length())-1; i>=0; i--)
	{
		if (map_zones[i].contains(x, y, z)) return map_zones[i].label;
	}
	return "";
}
