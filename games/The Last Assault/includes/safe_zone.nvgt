class safe_zone_area
{
	int minx, maxx, miny, maxy, minz, maxz;
	string label;
	safe_zone_area(int x1, int x2, int y1, int y2, int z1, int z2, const string&in name)
	{
		minx=x1; maxx=x2; miny=y1; maxy=y2; minz=z1; maxz=z2; label=name;
	}
	bool contains(int x, int y, int z) const
	{
		return x>=minx && x<=maxx && y>=miny && y<=maxy && z>=minz && z<=maxz;
	}
}

safe_zone_area@[] map_safe_zones;

void clear_map_safe_zones()
{
	map_safe_zones.resize(0);
}

void add_map_safe_zone(int minx, int maxx, int miny, int maxy, int minz, int maxz, const string&in label="Safe zone")
{
	safe_zone_area area(minx, maxx, miny, maxy, minz, maxz, label);
	map_safe_zones.insert_last(area);
}

string get_safe_zone_at(int x, int y, int z)
{
	for (int i=int(map_safe_zones.length())-1; i>=0; i--)
	{
		if (map_safe_zones[i].contains(x, y, z)) return map_safe_zones[i].label;
	}
	return "";
}
