key_hold left(KEY_LEFT,500,50);
key_hold right(KEY_RIGHT,500,50);
key_hold up(KEY_UP,500,50);
key_hold down(KEY_DOWN,500,50);
int found_reader=0;
sound_pool spool;
double game_master_gain=1.0;
timer game_volume_repeat_timer;
void fade(sound@ handle, double final_volume=0.0, double delay=25)
{
if (@handle==null || !handle.active) return;
// O volume do NVGT usa ganho linear entre 0.0 e 1.0. O fade BGT original
// trabalhava em decibéis; tentar chegar a -50 no NVGT prendia o menu para sempre.
double target_volume=final_volume;
if (target_volume<0.0) target_volume=0.0;
else if (target_volume>1.0) target_volume=1.0;

double start_volume=handle.volume;
if (start_volume<0.0) start_volume=0.0;
else if (start_volume>1.0) start_volume=1.0;
if(start_volume==target_volume) return;

const int fade_steps=50;
for (int step=1; step<=fade_steps; step++)
{
handle.volume=start_volume+(target_volume-start_volume)*double(step)/double(fade_steps);
wait(delay);
}
handle.volume=target_volume;
}
bool game_speak(string text, bool interrupt=true)
{
text=tr(text);
if(found_reader==0)
found_reader=auto_select_screen_reader();
if(found_reader==0)
{
if(interrupt)
tts.speak_interrupt(text);
else
tts.speak(text);
}
if(interrupt)
screen_reader_speak_interrupt(found_reader, text);
else
screen_reader_speak(found_reader, text);
return true;
}

double master_gain_to_db(double gain)
{
	if(gain<=0.0) return -100.0;
	if(gain>1.0) gain=1.0;
	return 20.0*log(gain)/log(10.0);
}

void load_game_audio_levels()
{
	if(game_config.exists("map_music_gain"))
	{
		map_music_gain=game_config.read_number("map_music_gain");
		if(map_music_gain<0.0) map_music_gain=0.0;
		if(map_music_gain>1.0) map_music_gain=1.0;
		apply_map_music_volume(float(map_music_gain));
	}
	if(game_config.exists("master_volume_gain"))
	{
		game_master_gain=game_config.read_number("master_volume_gain");
		if(game_master_gain<0.0) game_master_gain=0.0;
		if(game_master_gain>1.0) game_master_gain=1.0;
		set_sound_master_volume(float(master_gain_to_db(game_master_gain)));
	}
	else
	{
		double master_db=get_sound_master_volume();
		game_master_gain=master_db<=-100.0 ? 0.0 : pow(10.0,master_db/20.0);
	}
}

bool handle_game_volume_keys()
{
	bool alt=altisdown();
	bool music_up=alt && key_down(KEY_UP);
	bool music_down=alt && key_down(KEY_DOWN);
	bool master_up=!alt && key_down(KEY_HOME);
	bool master_down=!alt && key_down(KEY_END);
	if(!music_up && !music_down && !master_up && !master_down) return false;
	if(game_volume_repeat_timer.elapsed<150 && !key_pressed(KEY_UP) && !key_pressed(KEY_DOWN) && !key_pressed(KEY_HOME) && !key_pressed(KEY_END)) return true;
	game_volume_repeat_timer.restart();
	if(music_up || music_down)
	{
		map_music_gain+=(music_up ? 0.05 : -0.05);
		if(map_music_gain<0.0) map_music_gain=0.0;
		if(map_music_gain>1.0) map_music_gain=1.0;
		apply_map_music_volume(float(map_music_gain));
		game_config.write_number("map_music_gain",map_music_gain);
		game_speak(tr("Map music volume: ")+tr_percent(int(map_music_gain*100.0)));
	}
	else
	{
		game_master_gain+=(master_up ? 0.05 : -0.05);
		if(game_master_gain<0.0) game_master_gain=0.0;
		if(game_master_gain>1.0) game_master_gain=1.0;
		set_sound_master_volume(float(master_gain_to_db(game_master_gain)));
		game_config.write_number("master_volume_gain",game_master_gain);
		game_speak(tr("Master volume: ")+tr_percent(int(game_master_gain*100.0)));
	}
	return true;
}
void stopspeech()
{
for (uint i=1; i<=1; i++)
{
if (screen_reader_is_running(i))
{
screen_reader_stop_speech(i);
}
}
}
int auto_select_screen_reader()
{
if (screen_reader_is_running(1))
{
return 1;
}
if (screen_reader_is_running(3))
{
return 3;
}
if (screen_reader_is_running(4))
{
return 4;
}
else
{
return 0;
}
}
