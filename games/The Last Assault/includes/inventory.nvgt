int invpos;
dictionary inv;
timer usetimer;
bool takeobj;
bool usingmedkit=false;
void give(string item, int amount)
{
int a;
if (!inv.exists(item))
{
inv.set(item,amount);
}
else
{
inv.get(item,a);
if (a+amount<=0)
inv.delete(item);
else
{
inv.set(item,a+amount);
}
}
}
void cycle_inv(int dir)
{
if (dir==1)
invpos+=1;
else
invpos-=1;
if (invpos>=inv.get_size())
{
invpos=0;
}
else if (invpos<0)
{
invpos=inv.get_size()-1;
}
if (inv.get_size()==0)
{
game_speak("empty");
}
else
{
int a;
inv.get(inv.get_keys()[invpos],a);
	string item=string_replace(inv.get_keys()[invpos],"_"," ",true);
	game_speak(tr_inventory_status(a,item,invpos+1,inv.get_keys().length()));
}
}
void use(string item)
{
if (item=="medkit")
{
takeobj=true;
medpoints=0;
play("medkit");
usingmedkit=true;
medtimer.restart();
}
if (item=="Energy_potion")
{
takeobj=true;
play("potion");
movetime-=10;
}
else
{
takeobj=true;
}
if (takeobj==true) give(item,-1);
}
void take(string item, int amount=-1)
{
give(item,amount);
}
int get_item_count(string item)
{
int amount=0;
for (uint i=0; i<inv.get_keys().length(); i++)
{
int a=0;
if (inv.get_keys()[i]==item)
inv.get(inv.get_keys()[i],a);
amount+=a;
}
return amount;
}
void invstuff()
{
if (usetimer.elapsed>=130)
{
usetimer.restart();
if (inv.get_keys().length()>0 and invpos<inv.get_size())
use(inv.get_keys()[invpos]);
else game_speak("empty");
}
}
