bodyfall@[] bodyfalls(0);
class bodyfall
{
int btime=3000;
int x, y, z;
timer btimer;
bodyfall(int bx, int by, int bz, int bodytime=3000)
{
x=bx;
y=by;
z=bz;
btime=bodytime;
}
}
void bodyfallloop()
{
for (uint i=0; i<bodyfalls.length(); i++)
{
if (bodyfalls[i].btimer.elapsed>=bodyfalls[i].btime)
{
p.play_3d(game_audio_path(get_tile_at(bodyfalls[i].x,bodyfalls[i].y,bodyfalls[i].z)+"hardland.ogg"), me.x, me.y, me.z, bodyfalls[i].x, bodyfalls[i].y, bodyfalls[i].z, false);
@bodyfalls[i]=null;
bodyfalls.remove_at(i);
continue;
}
}
}
void spawn_bodyfall(int x, int y, int z, int time=4000)
{
bodyfall b1(x,y,z,time);
bodyfalls.insert_last(b1);
}
void killbodyfalls()
{
bodyfalls.resize(0);
}