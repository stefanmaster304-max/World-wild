const int BUILDER_STAY_IN_GAME=0;
const int BUILDER_RETURN_TO_MENU=1;
const int BUILDER_START_GAME=2;

dynamic_menu_pro map_builder_menu_object;
bool builder_world_ticks=false;
audio_form builder_live_form;
int[] builder_live_buttons;
string[] builder_live_actions;

void builder_advance_world()
{
	if(!builder_world_ticks) return;
	bulletloop();
	staircasecheckloop();
	enemyloop();
	map_audio_update();
	bodyfallloop();
	checkloc();
	p.update_listener_3d(me.x,me.y,me.z);
	gametime=ms_to_readable_time(gametimer.elapsed);
}

bool builder_is_audio_file(const string&in filename)
{
	string lower=string_to_lower_case(filename);
	int dot=lower.find_last(".");
	if(dot<0) return false;
	string ext=lower.substr(dot);
	return ext==".ogg" || ext==".wav" || ext==".mp3" || ext==".flac" || ext==".opus";
}

string[] map_sound_options(bool platforms_only)
{
	string[] options;
	string pattern=platforms_only ? "sounds/*step1.ogg" : "sounds/*.ogg";
	string[]@ files=find_files(pattern);
	if (files is null) return options;
	for (uint i=0; i<files.length(); i++)
	{
		string filename=string_replace(files[i], "\\", "/", true);
		int slash=filename.find_last("/");
		if (slash>=0) filename=filename.substr(slash+1);
		if (platforms_only)
		{
			if (filename.length()<=9 || filename.substr(filename.length()-9)!="step1.ogg") continue;
			filename=filename.substr(0, filename.length()-9);
		}
		if (options.find(filename)<0) options.insert_last(filename);
	}
	return options;
}

string[] map_audio_options(const string&in category)
{
	string[] options;
	string[] patterns;
	if(category=="music")
	{
		patterns.insert_last("sounds/Musics/*");
		patterns.insert_last("sounds/music/*");
	}
	else
	{
		patterns.insert_last("sounds/anbients/*");
		patterns.insert_last("sounds/ambients/*");
	}
	for(uint p=0;p<patterns.length();p++)
	{
		string[]@ files=find_files(patterns[p]);
		if(files is null) continue;
		for(uint i=0;i<files.length();i++)
		{
			string sound_path=string_replace(files[i],"\\","/",true);
			if(sound_path.find_first("sounds/")!=0) sound_path=patterns[p].substr(0,patterns[p].length()-1)+sound_path;
			if(!builder_is_audio_file(sound_path)) continue;
			if(options.find(sound_path)<0) options.insert_last(sound_path);
		}
	}
	if(category=="music" && options.length()==0 && file_exists("sounds/menumusic.ogg"))
		options.insert_last("sounds/menumusic.ogg");
	if(category!="music" && options.length()==0)
	{
		string[]@ files=find_files("sounds/*.ogg");
		if(files !is null)
		{
			string[] ambient_names={"birds","citybirds","lake","river","swamp"};
			for(uint i=0;i<files.length();i++)
			{
				string sound_path=string_replace(files[i],"\\","/",true);
				int slash=sound_path.find_last("/");
				string base=slash>=0 ? sound_path.substr(slash+1) : sound_path;
				string stem=string_to_lower_case(base);
				int dot=stem.find_last(".");
				if(dot>=0) stem=stem.substr(0,dot);
				if(ambient_names.find(stem)>=0 && options.find(base)<0) options.insert_last(base);
			}
		}
	}
	options.sort_ascending();
	return options;
}

bool builder_read_coord(audio_form@ form, int control, int&out value)
{
	string text=form.get_text(control).trim_whitespace();
	if (text=="") return false;
	uint first=0;
	if (string_left(text,1)=="-") first=1;
	if (first>=text.length()) return false;
	for (uint i=first; i<text.length(); i++)
	{
		string digit=text.substr(i,1);
		if (digit<"0" || digit>"9") return false;
	}
	value=int(string_to_number(text));
	return true;
}

bool builder_read_bounds(audio_form@ form, int cx1, int cx2, int cy1, int cy2, int cz1, int cz2,
	int&out x1, int&out x2, int&out y1, int&out y2, int&out z1, int&out z2)
{
	return builder_read_coord(form,cx1,x1) && builder_read_coord(form,cx2,x2)
		&& builder_read_coord(form,cy1,y1) && builder_read_coord(form,cy2,y2)
		&& builder_read_coord(form,cz1,z1) && builder_read_coord(form,cz2,z2)
		&& x1<=x2 && y1<=y2 && z1<=z2;
}

bool builder_confirm(const string&in question)
{
	audio_form form;
	form.create_window(tr(question), false, true, false);
	int yes_button=form.create_button(tr("Yes"), true);
	int no_button=form.create_button(tr("No"), false, true);
	form.set_default_controls(yes_button,no_button);
	while (true)
	{
		form.monitor();
		if (form.is_pressed(yes_button) || key_pressed(KEY_Y)) return true;
		if (form.is_pressed(no_button) || key_pressed(KEY_ESCAPE)) return false;
		wait(5);
		builder_advance_world();
	}
	return false;
}

bool create_new_map()
{
	audio_form form;
	form.create_window(tr("Create a new map"), false, true, false);
	int name_control=form.create_input_box(tr("Map name"));
	int x1_control=form.create_input_box(tr("Minimum X"),"0");
	int x2_control=form.create_input_box(tr("Maximum X"),"250");
	int y1_control=form.create_input_box(tr("Minimum Y"),"0");
	int y2_control=form.create_input_box(tr("Maximum Y"),"250");
	int z1_control=form.create_input_box(tr("Minimum Z"),"0");
	int z2_control=form.create_input_box(tr("Maximum Z"),"20");
	int platform_control=form.create_list(tr("Floor platform"));
	int create_button=form.create_button(tr("Create map"),true);
	int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(create_button,cancel_button);
	string[] platforms=map_sound_options(true);
	for (uint i=0; i<platforms.length(); i++) form.add_list_item(platform_control,platforms[i]);
	if (platforms.length()>0) form.focus_silently(platform_control);
	string selected_platform="";
	while (true)
	{
		wait(5);
		builder_advance_world();
		form.monitor();
		if (form.get_current_focus()==platform_control && key_pressed(KEY_SPACE))
		{
			int pos=form.get_list_position(platform_control);
			if (pos>=0 && pos<int(platforms.length()))
			{
				if (selected_platform!="") game_speak("You already selected a platform.");
				else { selected_platform=platforms[pos]; game_speak(tr_selected_floor(selected_platform)); }
			}
		}
		if (form.is_pressed(cancel_button)) return false;
		if (!form.is_pressed(create_button)) continue;
		string name=form.get_text(name_control).trim_whitespace();
		int x1,x2,y1,y2,z1,z2;
		if (!valid_map_name(name) || map_exists(name))
		{
			game_speak("Enter a valid map name that is not already in use.");
			continue;
		}
		if (!builder_read_bounds(form,x1_control,x2_control,y1_control,y2_control,z1_control,z2_control,x1,x2,y1,y2,z1,z2))
		{
			game_speak("The map coordinates are invalid. Minimum values must not exceed maximum values.");
			continue;
		}
		if (selected_platform=="") { game_speak("Select one floor platform by pressing Space on it."); continue; }
		string[] lines;
		lines.insert_last("name:"+name);
		lines.insert_last("bounds:"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2);
		lines.insert_last("platform:"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z1+":"+selected_platform);
		if (!save_map_lines(name,lines)) { game_speak("The map could not be written to the maps folder."); return false; }
		if (builder_confirm("Map " + name + " created. Go there now?"))
		{
			if (!load_map(name)) { game_speak("The new map could not be loaded."); return false; }
			me.x=x1; me.y=y1; me.z=z1;
			return true;
		}
		game_speak(tr("Map ")+name+tr(" created."));
		return false;
	}
	return false;
}

bool append_current_map_line(const string&in line)
{
	if (mapname=="" || !valid_map_name(mapname)) return false;
	string[] fields=string_split(line,":",false);
	if (fields.length()<7) return false;
	int x1=int(string_to_number(fields[1])), x2=int(string_to_number(fields[2]));
	int y1=int(string_to_number(fields[3])), y2=int(string_to_number(fields[4]));
	int z1=int(string_to_number(fields[5])), z2=int(string_to_number(fields[6]));
	if (x1<map_min_x || x2>map_max_x || y1<map_min_y || y2>map_max_y || z1<map_min_z || z2>map_max_z)
	{
		game_speak("The selected area must fit inside the current map bounds.");
		return false;
	}
	current_map_lines.insert_last(line);
	if (!save_map_lines(mapname,current_map_lines))
	{
		current_map_lines.remove_last();
		return false;
	}
	return load_map(mapname);
}

bool builder_destination_range_valid(const string&in target,int x1,int x2,int y1,int y2,int z1,int z2)
{
	file map_file;
	if(!map_file.open(map_file_path(target),"rb")) return false;
	string[] lines=string_split(map_file.read(),"\n",false);
	map_file.close();
	for(uint i=0;i<lines.length();i++)
	{
		string[] fields=string_split(lines[i].trim_whitespace(),":",false);
		if(fields.length()<7 || string_to_lower_case(fields[0])!="bounds") continue;
		int minx=int(string_to_number(fields[1])),maxx=int(string_to_number(fields[2]));
		int miny=int(string_to_number(fields[3])),maxy=int(string_to_number(fields[4]));
		int minz=int(string_to_number(fields[5])),maxz=int(string_to_number(fields[6]));
		return x1>=minx && x2<=maxx && y1>=miny && y2<=maxy && z1>=minz && z2<=maxz;
	}
	return false;
}

string builder_area_record(const string&in command)
{
	audio_form form;
	string command_name=command=="safezone" ? tr("safe zone") : (command=="source" ? tr("sound source") : (command=="ambient" ? tr("ambient sound") : tr(command)));
	form.create_window(tr("Add ")+command_name, false, true, false);
	int cx1=form.create_input_box(tr("Minimum X")); int cx2=form.create_input_box(tr("Maximum X"));
	int cy1=form.create_input_box(tr("Minimum Y")); int cy2=form.create_input_box(tr("Maximum Y"));
	int cz1=form.create_input_box(tr("Minimum Z")); int cz2=form.create_input_box(tr("Maximum Z"));
	int value_control=-1;
	int list_control=-1;
	int category_control=-1, music_list_control=-1, source_list_control=-1;
	int volume_control=-1, pitch_control=-1;
	string[] options;
	if (command=="zone") value_control=form.create_input_box(tr("Zone name"));
	else if(command=="safezone") { }
	else if(command=="ambient")
	{
		category_control=form.create_list(tr("Sound category"));
		form.add_list_item(category_control,tr("Music"));
		form.add_list_item(category_control,tr("Sources"));
		music_list_control=form.create_list(tr("Map music"));
		source_list_control=form.create_list(tr("Environmental sources"));
		string[] music_options=map_audio_options("music");
		string[] source_options=map_audio_options("sources");
		options=music_options;
		for(uint i=0;i<music_options.length();i++) form.add_list_item(music_list_control,music_options[i]);
		for(uint i=0;i<source_options.length();i++) form.add_list_item(source_list_control,source_options[i]);
		form.set_state(music_list_control,true,true);
		form.set_state(source_list_control,false,false);
		list_control=music_list_control;
	}
	else
	{
		list_control=form.create_list(tr(command=="staircase" ? "Stair platform" : (command=="platform" ? "Floor platform" : "Environmental sound source")));
		options=(command=="platform" || command=="staircase") ? map_sound_options(true) : map_audio_options("sources");
		for(uint i=0;i<options.length();i++) form.add_list_item(list_control,options[i]);
	}
	if(command=="source" || command=="ambient")
	{
		volume_control=form.create_slider(tr("Sound volume"),1.0,0.0,1.0,"",0.05);
		pitch_control=form.create_slider(tr("Sound pitch"),100,50,200,"",5);
	}
	int add_button=form.create_button(tr("Add"),true); int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(add_button,cancel_button);
	if (list_control>=0) form.focus_silently(list_control);
	string selected="";
	while(true)
	{
		wait(5); builder_advance_world(); form.monitor();
		if(command=="ambient")
		{
			bool music_selected=form.get_list_position(category_control)==0;
			form.set_state(music_list_control,music_selected,music_selected);
			form.set_state(source_list_control,!music_selected,!music_selected);
			list_control=music_selected ? music_list_control : source_list_control;
			options=music_selected ? map_audio_options("music") : map_audio_options("sources");
		}
		if(list_control>=0 && form.get_current_focus()==list_control && key_pressed(KEY_SPACE))
		{
			int pos=form.get_list_position(list_control);
			if(pos>=0 && pos<int(options.length()))
			{
				if(selected!="") game_speak("You already selected an item.");
				else { selected=options[pos]; game_speak(tr_selected_item(selected)); }
			}
		}
		if(form.is_pressed(cancel_button)) return "";
		if(!form.is_pressed(add_button)) continue;
		int x1,x2,y1,y2,z1,z2;
		if(!builder_read_bounds(form,cx1,cx2,cy1,cy2,cz1,cz2,x1,x2,y1,y2,z1,z2)) { game_speak("Invalid coordinates."); continue; }
		if((command=="ambient" || command=="source") && list_control>=0)
		{
			int sound_pos=form.get_list_position(list_control);
			string[] current_options=(command=="ambient" && form.get_list_position(category_control)==0) ? map_audio_options("music") : map_audio_options("sources");
			if(sound_pos>=0 && sound_pos<int(current_options.length())) selected=current_options[sound_pos];
		}
		string value=(value_control>=0) ? form.get_text(value_control).trim_whitespace() : selected;
		if(value=="" && command!="safezone") { game_speak("Choose or enter a value first."); continue; }
		if(command=="ambient" || command=="source")
		{
			string category=(command=="ambient" && form.get_list_position(category_control)==0) ? "music" : "sources";
			string map_command=command=="ambient" ? "ambience" : "source";
			return map_command+":"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2+":"+value+":"+form.get_slider(volume_control)+":"+form.get_slider(pitch_control)+":"+category;
		}
		if(command=="platform" || command=="staircase")
			return command+":"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2+":"+value;
		if(command=="safezone")
			return command+":"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2;
		if(command=="zone")
			return command+":"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2+":"+value;
		return command+":"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2+":"+value;
	}
	return "";
}

string builder_travel_record()
{
	audio_form form;
	form.create_window(tr("Add travel point"),false,true,false);
	int cx1=form.create_input_box(tr("Minimum X")); int cx2=form.create_input_box(tr("Maximum X"));
	int cy1=form.create_input_box(tr("Minimum Y")); int cy2=form.create_input_box(tr("Maximum Y"));
	int cz1=form.create_input_box(tr("Minimum Z")); int cz2=form.create_input_box(tr("Maximum Z"));
	int dest=form.create_input_box(tr("Destination map"));
	int dx1=form.create_input_box(tr("Destination minimum X"),"0"); int dx2=form.create_input_box(tr("Destination maximum X"),"0");
	int dy1=form.create_input_box(tr("Destination minimum Y"),"0"); int dy2=form.create_input_box(tr("Destination maximum Y"),"0");
	int dz1=form.create_input_box(tr("Destination minimum Z"),"0"); int dz2=form.create_input_box(tr("Destination maximum Z"),"0");
	int add_button=form.create_button(tr("Add travel point"),true); int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(add_button,cancel_button);
	while(true)
	{
		wait(5); builder_advance_world(); form.monitor();
		if(form.is_pressed(cancel_button)) return "";
		if(!form.is_pressed(add_button)) continue;
		int x1,x2,y1,y2,z1,z2,tx1,tx2,ty1,ty2,tz1,tz2;
		if(!builder_read_bounds(form,cx1,cx2,cy1,cy2,cz1,cz2,x1,x2,y1,y2,z1,z2)
			|| !builder_read_coord(form,dx1,tx1) || !builder_read_coord(form,dx2,tx2)
			|| !builder_read_coord(form,dy1,ty1) || !builder_read_coord(form,dy2,ty2)
			|| !builder_read_coord(form,dz1,tz1) || !builder_read_coord(form,dz2,tz2))
		{ game_speak("Invalid travel point coordinates."); continue; }
		string target=form.get_text(dest).trim_whitespace();
		if(!valid_map_name(target) || !map_exists(target)) { game_speak("The destination map does not exist."); continue; }
		if(tx1>tx2 || ty1>ty2 || tz1>tz2) { game_speak("Destination minimum coordinates must not exceed their maximum values."); continue; }
		if(!builder_destination_range_valid(target,tx1,tx2,ty1,ty2,tz1,tz2)) { game_speak("The destination coordinates must fit inside the target map bounds."); continue; }
		return "travelpoint:"+x1+":"+x2+":"+y1+":"+y2+":"+z1+":"+z2+":"+target+":"+tx1+":"+tx2+":"+ty1+":"+ty2+":"+tz1+":"+tz2;
	}
	return "";
}

bool builder_record_is_editable(const string&in line)
{
	string[] fields=string_split(line,":",false);
	if(fields.length()==0) return false;
	string command=string_to_lower_case(fields[0]);
	return command=="platform" || command=="zone" || command=="safezone" || command=="staircase" || command=="source" || command=="src" || command=="ambient" || command=="ambience" || command=="travelpoint";
}

bool builder_record_is_valid(const string&in line)
{
	string[] fields=string_split(line,":",false);
	if(fields.length()==0) return false;
	string command=string_to_lower_case(fields[0]);
	if(command!="platform" && command!="staircase" && command!="source" && command!="src" && command!="ambient" && command!="ambience" && command!="zone" && command!="safezone" && command!="travelpoint") return false;
	if((command=="safezone" && fields.length()<7) || (command!="safezone" && fields.length()<8)) return false;
	int[] coords;
	for(uint i=0;i<6;i++)
	{
		string value=fields[i+1];
		if(value=="") return false;
		uint first=string_left(value,1)=="-" ? 1 : 0;
		if(first>=value.length()) return false;
		for(uint c=first;c<value.length();c++)
		{
			string digit=value.substr(c,1);
			if(digit<"0" || digit>"9") return false;
		}
		coords.insert_last(int(string_to_number(value)));
	}
	if(coords[0]>coords[1] || coords[2]>coords[3] || coords[4]>coords[5]) return false;
	if(coords[0]<map_min_x || coords[1]>map_max_x || coords[2]<map_min_y || coords[3]>map_max_y || coords[4]<map_min_z || coords[5]>map_max_z) return false;
	if(command=="travelpoint")
	{
		if(!map_exists(fields.length()>7 ? fields[7] : "")) return false;
		if(fields.length()>=14)
		{
			int dx1=int(string_to_number(fields[8])),dx2=int(string_to_number(fields[9]));
			int dy1=int(string_to_number(fields[10])),dy2=int(string_to_number(fields[11]));
			int dz1=int(string_to_number(fields[12])),dz2=int(string_to_number(fields[13]));
			return dx1<=dx2 && dy1<=dy2 && dz1<=dz2 && builder_destination_range_valid(fields[7],dx1,dx2,dy1,dy2,dz1,dz2);
		}
		if(fields.length()>=11)
		{
			int dx=int(string_to_number(fields[8])),dy=int(string_to_number(fields[9])),dz=int(string_to_number(fields[10]));
			return builder_destination_range_valid(fields[7],dx,dx,dy,dy,dz,dz);
		}
		return false;
	}
	if(command=="safezone") return fields.length()==7 || fields[7].trim_whitespace()!="";
	if(command=="zone") return fields[7].trim_whitespace()!="";
	if(command=="source" || command=="src" || command=="ambient" || command=="ambience")
	{
		string filename=fields[7];
		if(fields.length()>=9 && (fields[7]=="music" || fields[7]=="sources")) filename=fields[8];
		if(fields.length()>=11 && (fields[10]=="music" || fields[10]=="sources")) filename=fields[7];
		return filename.trim_whitespace()!="" && file_exists(game_audio_path(filename));
	}
	if(command=="platform" || command=="staircase")
		return file_exists("sounds/"+fields[7]+"step1.ogg");
	return false;
}

bool edit_current_map_line(int line_index)
{
	if(line_index<0 || line_index>=int(current_map_lines.length()) || !builder_record_is_editable(current_map_lines[line_index])) return false;
	audio_form form;
	form.create_window(tr("Edit map line"),false,true,false);
	int line_control=form.create_input_box(tr("Map record"),current_map_lines[line_index]);
	int save_button=form.create_button(tr("Save line"),true); int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(save_button,cancel_button);
	while(true)
	{
		wait(5); builder_advance_world(); form.monitor();
		if(form.is_pressed(cancel_button)) return false;
		if(!form.is_pressed(save_button)) continue;
		string updated=form.get_text(line_control).trim_whitespace();
		if(!builder_record_is_valid(updated)) { game_speak("This record is not valid for this map."); continue; }
		string[] fields=string_split(updated,":",false);
		string command=string_to_lower_case(fields[0]);
		if(command!="platform" && command!="zone" && command!="safezone" && command!="staircase" && command!="source" && command!="ambient" && command!="travelpoint")
		{ game_speak("Map name and bounds cannot be edited here."); continue; }
		current_map_lines[line_index]=updated;
		if(!save_map_lines(mapname,current_map_lines)) { game_speak("The map could not be saved."); return false; }
		return load_map(mapname);
	}
	return false;
}

bool builder_add_map_line()
{
	audio_form form;
	form.create_window(tr("Add line to map"),false,true,false);
	int line_control=form.create_input_box(tr("Line content"));
	int add_button=form.create_button(tr("Add"),true);
	int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(add_button,cancel_button);
	while(true)
	{
		wait(5); builder_advance_world(); form.monitor();
		if(form.is_pressed(cancel_button)) return false;
		if(!form.is_pressed(add_button)) continue;
		string line=form.get_text(line_control).trim_whitespace();
		if(!builder_record_is_editable(line) || !builder_record_is_valid(line))
		{
			game_speak("This record is not valid for this map.");
			continue;
		}
		current_map_lines.insert_last(line);
		if(!save_map_lines(mapname,current_map_lines)) return false;
		return load_map(mapname);
	}
	return false;
}

bool builder_rename_current_map()
{
	audio_form form;
	form.create_window(tr("Rename map"),false,true,false);
	int name_control=form.create_input_box(tr("Map name"),mapname);
	int save_button=form.create_button(tr("Save map name"),true);
	int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(save_button,cancel_button);
	while(true)
	{
		wait(5); builder_advance_world(); form.monitor();
		if(form.is_pressed(cancel_button)) return false;
		if(!form.is_pressed(save_button)) continue;
		string new_name=form.get_text(name_control).trim_whitespace();
		if(!valid_map_name(new_name) || (new_name!=mapname && map_exists(new_name)))
		{
			game_speak("Enter a valid map name that is not already in use.");
			continue;
		}
		if(new_name==mapname) return true;
		string old_name=mapname;
		bool found_name=false;
		for(uint i=0;i<current_map_lines.length();i++)
		{
			string[] fields=string_split(current_map_lines[i],":",false);
			if(fields.length()>=2 && string_to_lower_case(fields[0])=="name")
			{
				current_map_lines[i]="name:"+new_name;
				found_name=true;
				break;
			}
		}
		if(!found_name) current_map_lines.insert_at(0,"name:"+new_name);
		if(!save_map_lines(new_name,current_map_lines)) return false;
		file_delete(map_file_path(old_name));
		return load_map(new_name);
	}
	return false;
}

bool builder_add_clipboard_line()
{
	string line=clipboard_read_text().trim_whitespace();
	if(!builder_record_is_editable(line) || !builder_record_is_valid(line))
	{
		game_speak("This record is not valid for this map.");
		return false;
	}
	current_map_lines.insert_last(line);
	return save_map_lines(mapname,current_map_lines) && load_map(mapname);
}

void edit_current_map_lines()
{
	while(true)
	{
		audio_form form;
		form.create_window(tr("Edit current map lines"),false,true,false);
		int lines_control=form.create_list(tr("Map records"));
		for(uint i=0;i<current_map_lines.length();i++) form.add_list_item(lines_control,current_map_lines[i]);
		int edit_button=form.create_button(tr("Edit selected line"));
		int add_button=form.create_button(tr("Add line"));
		int delete_button=form.create_button(tr("Delete selected line"));
		int copy_button=form.create_button(tr("Copy selected line"));
		int paste_button=form.create_button(tr("Paste line"));
		int rename_button=form.create_button(tr("Rename map"));
		int copy_all_button=form.create_button(tr("Copy all map lines"));
		int close_button=form.create_button(tr("Close"),false,true);
		form.set_default_controls(edit_button,close_button);
		form.focus_silently(lines_control);
		bool reopen=false;
		while(true)
		{
			wait(5); builder_advance_world(); form.monitor();
			int selected=form.get_list_position(lines_control);
			bool delete_requested=(form.get_current_focus()==lines_control && key_pressed(KEY_DELETE)) || form.is_pressed(delete_button);
			if(form.is_pressed(close_button)) return;
			if(delete_requested)
			{
				if(selected<0 || selected>=int(current_map_lines.length())) continue;
				if(!builder_record_is_editable(current_map_lines[selected])) { game_speak("Map name and bounds are protected."); continue; }
				current_map_lines.remove_at(selected);
				if(!save_map_lines(mapname,current_map_lines)) { game_speak("The map could not be saved."); return; }
				if(!load_map(mapname)) { game_speak("The map is no longer valid."); return; }
				reopen=true; break;
			}
			if(form.is_pressed(edit_button))
			{
				if(selected<0 || selected>=int(current_map_lines.length())) { game_speak("Select a map line first."); continue; }
				if(!builder_record_is_editable(current_map_lines[selected])) { game_speak("Map name and bounds are protected."); continue; }
				edit_current_map_line(selected);
				reopen=true; break;
			}
			if(form.is_pressed(add_button))
			{
				builder_add_map_line();
				reopen=true; break;
			}
			if(form.is_pressed(copy_button))
			{
				if(selected>=0 && selected<int(current_map_lines.length())) clipboard_copy_text(current_map_lines[selected]);
				else game_speak("Select a map line first.");
			}
			if(form.is_pressed(paste_button))
			{
				builder_add_clipboard_line();
				reopen=true; break;
			}
			if(form.is_pressed(copy_all_button))
			{
				string all_lines="";
				for(uint i=0;i<current_map_lines.length();i++) all_lines+=current_map_lines[i]+"\n";
				clipboard_copy_text(all_lines);
			}
			if(form.is_pressed(rename_button))
			{
				builder_rename_current_map();
				reopen=true; break;
			}
		}
		if(!reopen) return;
	}
}

bool delete_current_map()
{
	string deleting=mapname;
	if(!builder_confirm("Delete the current map " + deleting + "?")) return false;
	if(!file_delete(map_file_path(deleting))) { game_speak("The map file could not be deleted."); return false; }
	clear_map_data();
	return true;
}

int map_builder_menu()
{
	map_builder_menu_object.reset(false);
	map_builder_menu_object.enable_up_and_down=true;
	map_builder_menu_object.enable_home_and_end=true;
	map_builder_menu_object.add_item_tts("Create new map","create");
	if (mapname!="")
	{
		map_builder_menu_object.add_item_tts("Edit current map lines","edit");
		map_builder_menu_object.add_item_tts("Delete current map","delete");
		map_builder_menu_object.add_item_tts("Add platform","platform");
		map_builder_menu_object.add_item_tts("Add zone","zone");
		map_builder_menu_object.add_item_tts("Add safe zone","safezone");
		map_builder_menu_object.add_item_tts("Add travel point","travel");
		map_builder_menu_object.add_item_tts("Add positional sound source","source");
		map_builder_menu_object.add_item_tts("Add area ambient sound","ambient");
		map_builder_menu_object.add_item_tts("Add staircase","staircase");
	}
	int result=map_builder_menu_object.run("Map construction menu",true);
	string selected=map_builder_menu_object.get_item_name(result);
	if(selected=="create")
	{
		if(create_new_map()) return BUILDER_START_GAME;
	}
	else if(selected=="edit") edit_current_map_lines();
	else if(selected=="delete")
	{
		if(delete_current_map()) return BUILDER_RETURN_TO_MENU;
	}
	else if(selected=="platform" || selected=="zone" || selected=="safezone" || selected=="source" || selected=="ambient" || selected=="staircase")
	{
		string record=builder_area_record(selected);
		if(record!="" && !append_current_map_line(record)) game_speak("The map change could not be saved and loaded.");
	}
	else if(selected=="travel")
	{
		string record=builder_travel_record();
		if(record!="" && !append_current_map_line(record)) game_speak("The travel point could not be saved and loaded.");
	}
	return BUILDER_STAY_IN_GAME;
}

int map_builder_menu_live()
{
	builder_world_ticks=true;
	while(true)
	{
		builder_live_form.reset();
		builder_live_form.create_window(tr("Map construction menu"),false,true,false);
		builder_live_buttons.resize(0);
		builder_live_actions.resize(0);
		int button=builder_live_form.create_button(tr("Create new map"));
		builder_live_buttons.insert_last(button); builder_live_actions.insert_last("create");
		if(mapname!="")
		{
			button=builder_live_form.create_button(tr("Edit current map lines"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("edit");
			button=builder_live_form.create_button(tr("Delete current map"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("delete");
			button=builder_live_form.create_button(tr("Add platform"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("platform");
			button=builder_live_form.create_button(tr("Add zone"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("zone");
			button=builder_live_form.create_button(tr("Add safe zone"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("safezone");
			button=builder_live_form.create_button(tr("Add travel point"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("travel");
			button=builder_live_form.create_button(tr("Add positional sound source"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("source");
			button=builder_live_form.create_button(tr("Add area ambient sound"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("ambient");
			button=builder_live_form.create_button(tr("Add staircase"));
			builder_live_buttons.insert_last(button); builder_live_actions.insert_last("staircase");
		}
		int close_button=builder_live_form.create_button(tr("Close"),false,true);
		builder_live_form.set_default_controls(builder_live_buttons[0],close_button);
		while(true)
		{
			wait(5);
			builder_advance_world();
			builder_live_form.monitor();
			if(builder_live_form.is_pressed(close_button) || key_pressed(KEY_ESCAPE))
			{
				builder_world_ticks=false;
				return BUILDER_STAY_IN_GAME;
			}
			string selected="";
			for(uint i=0;i<builder_live_buttons.length();i++)
			{
				if(builder_live_form.is_pressed(builder_live_buttons[i]))
				{
					selected=builder_live_actions[i];
					break;
				}
			}
			if(selected=="") continue;
			if(selected=="create") create_new_map();
			else if(selected=="edit") edit_current_map_lines();
			else if(selected=="delete")
			{
				if(delete_current_map())
				{
					builder_world_ticks=false;
					return BUILDER_RETURN_TO_MENU;
				}
			}
			else if(selected=="travel")
			{
				string line=builder_travel_record();
				if(line!="" && !append_current_map_line(line)) game_speak("The travel point could not be saved and loaded.");
			}
			else
			{
				string line=builder_area_record(selected);
				if(line!="" && !append_current_map_line(line)) game_speak("The map change could not be saved and loaded.");
			}
			break;
		}
	}
	builder_world_ticks=false;
	return BUILDER_STAY_IN_GAME;
}
