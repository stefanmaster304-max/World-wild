sound_pool sp(100000);
source@[] src(0);
class source
{
int x1, x2, y1, y2, z1, z2, sound;
string file;
source(int sx1, int sx2, int sy1, int sy2, int sz1, int sz2, string sf)
{
x1=sx1;
x2=sx2;
y1=sy1;
y2=sy2;
z1=sz1;
z2=sz2;
file=sf;
sound=sp.play_3d(game_audio_path(file), me.x, me.y, me.z, x1, y1, z1, true);
}
}
void sourceloop()
{
for(uint i=0; i<src.length(); i++)
{
sp.update_listener_3d(me.x, me.y, me.z);
sp.update_sound_range_3d(src[i].sound, (me.x-src[i].x1), (src[i].x2-src[i].x1), (me.y-src[i].y1), (src[i].y2-src[i].y1), (me.z-src[i].z1), (src[i].z2-src[i].z1));
}
}
void spawn_source(int sx1, int sx2, int sy1, int sy2, int sz1, int sz2, string sf)
{
source s1(sx1, sx2, sy1, sy2, sz1, sz2, sf);
src.insert_last(s1);
}
void killsrcs()
{
sp.destroy_all();
src.resize(0);
}
void pause_srcs()
{
sp.pause_all();
}
void resume_srcs()
{
sp.resume_all();
}