sound_pool sp(256);
float map_music_gain=1.0;

bool is_music_audio_asset(const string&in filename)
{
	string lower=string_to_lower_case(string_replace(filename,"\\","/",true));
	return lower.find_first("/music/")>=0 || lower.find_first("/musics/")>=0 || lower.find_first("menumusic")>=0;
}

class map_audio_item
{
	int minx,maxx,miny,maxy,minz,maxz;
	int sound_slot;
	float local_gain,pitch;
	bool area_limited,is_music,is_playing;
	map_audio_item(int x1,int x2,int y1,int y2,int z1,int z2,const string&in file,float gain,float pitch_value,bool limited,bool music)
	{
		minx=x1; maxx=x2; miny=y1; maxy=y2; minz=z1; maxz=z2;
		local_gain=gain; pitch=pitch_value; area_limited=limited; is_music=music;
		int cx=(x1+x2)/2,cy=(y1+y2)/2,cz=(z1+z2)/2;
		if(limited) sound_slot=sp.play_stationary_extended(file,true,0.0,0.0,gain*(music ? map_music_gain : 1.0),pitch_value);
		else sound_slot=sp.play_3d(file,me.x,me.y,me.z,cx,cy,cz,true);
		is_playing=(sound_slot>=0);
		apply_settings();
		if(area_limited && !contains(me.x,me.y,me.z))
		{
			sp.pause_sound(sound_slot);
			is_playing=false;
		}
	}
	bool contains(int x,int y,int z) const
	{
		return x>=minx && x<=maxx && y>=miny && y<=maxy && z>=minz && z<=maxz;
	}
	void apply_settings()
	{
		if(sound_slot<0) return;
		float gain=local_gain*(is_music ? map_music_gain : 1.0);
		if(gain<0.0) gain=0.0;
		if(gain>1.0) gain=1.0;
		sp.update_sound_start_values(sound_slot,0.0,gain,pitch);
	}
}

map_audio_item@[] map_audio_items;

void spawn_source(int x1,int x2,int y1,int y2,int z1,int z2,const string&in filename,float volume=1.0,float pitch=100.0,bool is_music=false)
{
	map_audio_item item(x1,x2,y1,y2,z1,z2,filename,volume,pitch,false,is_music);
	map_audio_items.insert_last(item);
}

void spawn_ambient_source(int x1,int x2,int y1,int y2,int z1,int z2,const string&in filename,float volume=1.0,float pitch=100.0,bool is_music=false)
{
	map_audio_item item(x1,x2,y1,y2,z1,z2,filename,volume,pitch,true,is_music);
	map_audio_items.insert_last(item);
}

void apply_map_music_volume(float gain)
{
	if(gain<0.0) gain=0.0;
	if(gain>1.0) gain=1.0;
	map_music_gain=gain;
	for(uint i=0;i<map_audio_items.length();i++)
		if(map_audio_items[i].is_music) map_audio_items[i].apply_settings();
}

void update_map_audio(int x,int y,int z)
{
	for(uint i=0;i<map_audio_items.length();i++)
	{
		map_audio_item@ item=map_audio_items[i];
		if(!item.area_limited || item.sound_slot<0) continue;
		bool inside=item.contains(x,y,z);
		if(inside && !item.is_playing)
		{
			item.apply_settings();
			if(sp.resume_sound(item.sound_slot)) item.is_playing=true;
		}
		else if(!inside && item.is_playing)
		{
			sp.pause_sound(item.sound_slot);
			item.is_playing=false;
		}
	}
}

void destroy_map_audio()
{
	sp.destroy_all();
	map_audio_items.resize(0);
}

void killsrcs()
{
	destroy_map_audio();
}
