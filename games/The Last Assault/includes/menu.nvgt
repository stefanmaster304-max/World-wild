dynamic_menu_pro m;

void setupmenu(bool music=false)
{
	m.reset(false);
	m.wrap=menu_wrap_enabled;
	m.enable_up_and_down=true;
	m.enable_home_and_end=true;
	m.enable_first_letter_navigation=true;
	if(music)
	{
		m.add_music(game_audio_path("menumusic.ogg"));
		m.music_added=true;
	}
	else
	{
		m.stop_music();
		m.music_added=false;
	}
}

string read_documentation(const string&in path)
{
	file document;
	if(!document.open(path,"rb")) return tr("Could not open documentation file: ")+path;
	string contents=document.read();
	document.close();
	return contents;
}

void show_document(const string&in path,const string&in title)
{
	string contents=read_documentation(path);
	audio_form form;
	form.create_window(title,false,true,false);
	int text_control=form.create_input_box(tr("Documentation text"),contents,"",0,true,true,false);
	int close_button=form.create_button(tr("Close"),true,true);
	form.set_default_controls(close_button,close_button);
	form.focus_silently(text_control);
	while(true)
	{
		form.monitor();
		if(form.is_pressed(close_button) || key_pressed(KEY_ESCAPE)) return;
		wait(5);
	}
}

void documentation_menu()
{
	m.stop_music();
	audio_form form;
	form.create_window(tr("Documentation"),false,true,false);
	int language_control=form.create_list(tr("Documentation language"));
	form.add_list_item(language_control,tr("English"),"en");
	form.add_list_item(language_control,tr("Portuguese"),"pt");
	int file_control=form.create_list(tr("Documentation file"));
	form.add_list_item(file_control,tr("README"),"readme");
	form.add_list_item(file_control,tr("Changelog"),"changelog");
	int open_button=form.create_button(tr("Open document"),true);
	int close_button=form.create_button(tr("Close"),false,true);
	form.set_default_controls(open_button,close_button);
	form.focus_silently(language_control);
	string selected_language="en";
	string selected_file="readme";
	while(true)
	{
		form.monitor();
		if(form.is_pressed(close_button) || key_pressed(KEY_ESCAPE)) return;
		if(form.is_pressed(open_button))
		{
			int language_position=form.get_list_position(language_control);
			int file_position=form.get_list_position(file_control);
			if(language_position==1) selected_language="pt";
			else selected_language="en";
			if(file_position==1) selected_file="changelog";
			else selected_file="readme";
			break;
		}
		wait(5);
	}
	string path,title;
	if(selected_file=="readme")
	{
		path=selected_language=="pt" ? "README.md" : "README.en.md";
		title=tr("README")+" — "+tr(selected_language=="pt" ? "Portuguese" : "English");
	}
	else
	{
		path=selected_language=="pt" ? "CHANGELOG.md" : "CHANGELOG.en.md";
		title=tr("Changelog")+" — "+tr(selected_language=="pt" ? "Portuguese" : "English");
	}
	show_document(path,title);
	mainmenu();
}

void settings_menu()
{
	m.stop_music();
	audio_form form;
	form.create_window(tr("Settings"),false,true,false);
	int language_control=form.create_list(tr("Game language"));
	string[] language_ids={"en","pt","es","tr","vi"};
	string[] language_names={"English","Portuguese","Spanish","Turkish","Vietnamese"};
	int selected_language=language_ids.find(game_language);
	for(uint i=0;i<language_ids.length();i++)
		form.add_list_item(language_control,tr(language_names[i]),language_ids[i],-1,int(i)==selected_language,false);
	if(selected_language>=0) form.set_list_position(language_control,selected_language,false);
	int wrap_control=form.create_checkbox(tr("Enable menu wrapping"),menu_wrap_enabled);
	int save_button=form.create_button(tr("Save settings"),true);
	int cancel_button=form.create_button(tr("Cancel"),false,true);
	form.set_default_controls(save_button,cancel_button);
	form.focus_silently(language_control);
	while(true)
	{
		form.monitor();
		if(form.is_pressed(cancel_button) || key_pressed(KEY_ESCAPE)) return;
		if(form.is_pressed(save_button))
		{
			int language_position=form.get_list_position(language_control);
			if(language_position>=0 && language_position<int(language_ids.length()))
				game_language=language_ids[language_position];
			menu_wrap_enabled=form.is_checked(wrap_control);
			load_language_file(game_language);
			game_config.write_string("language",game_language);
			game_config.write_number("menu_wrap",menu_wrap_enabled ? 1 : 0);
			return;
		}
		wait(5);
	}
}

void mainmenu()
{
	setupmenu(true);
	m.add_item_tts("Play","play");
	m.add_item_tts("Documentation","documentation");
	m.add_item_tts("Settings","settings");
	m.add_item_tts("Exit","exit");
	int mres=m.run(tr("Main menu"),true);
	string menuitem=m.get_item_name(mres);
	if(menuitem=="play")
	{
		m.fade_music(20);
		string[] maps=available_map_names();
		if(maps.length()==0)
		{
			alert(tr("Map loading error"),tr("There are no valid map files in the maps folder."));
			mainmenu(); return;
		}
		string selected_map=maps[0];
		if(maps.length()>1)
		{
			setupmenu(false);
			for(uint i=0;i<maps.length();i++) m.add_item_tts(maps[i],maps[i]);
			int map_result=m.run(tr("Select a map"),true);
			if(map_result<0) { mainmenu(); return; }
			selected_map=m.get_item_name(map_result);
		}
		if(!load_map(selected_map))
		{
			alert(tr("Map loading error"),tr("The selected map could not be loaded."));
			mainmenu(); return;
		}
		if(game_config.exists("map") && game_config.read_string("map")==selected_map)
		{
			if(game_config.exists("x")) me.x=game_config.read_number("x");
			if(game_config.exists("y")) me.y=game_config.read_number("y");
			if(game_config.exists("z")) me.z=game_config.read_number("z");
		}
		if(me.x<map_min_x || me.x>map_max_x || me.y<map_min_y || me.y>map_max_y || me.z<map_min_z || me.z>map_max_z)
		{
			me.x=map_min_x; me.y=map_min_y; me.z=map_min_z;
		}
		map_audio_update();
		announce_current_zone();
		play("start");
		game();
	}
	else if(menuitem=="documentation") documentation_menu();
	else if(menuitem=="settings") { settings_menu(); mainmenu(); }
	else
	{
		m.fade_music(20);
		save_player_properties();
		exit();
	}
}

void helpmenu() { documentation_menu(); }

int menuquestion(string q)
{
	setupmenu(false);
	m.add_item_tts("Yes"); m.add_item_tts("No");
	int result=m.run(tr(q),true);
	return result==1 ? 1 : 2;
}
